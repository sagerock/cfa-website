---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import facultyData from '../data/faculty.json';
import { TAG_LABEL } from '../data/programMeta.js';

const people = [...facultyData.faculty].sort((a, b) =>
  a.name.split(' ').pop().toLowerCase().localeCompare(b.name.split(' ').pop().toLowerCase())
);
const activeN = people.filter((p) => p.active).length;
const archN = people.length - activeN;

const tagCounts = {};
for (const p of people) for (const t of p.programs) tagCounts[t] = (tagCounts[t] || 0) + 1;
const tags = Object.keys(TAG_LABEL).filter((t) => tagCounts[t]);

const initials = (name) => {
  const parts = name.replace(/[^A-Za-z\s]/g, ' ').split(/\s+/).filter(Boolean);
  return parts.length >= 2
    ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
    : (parts[0] || '–').slice(0, 2).toUpperCase();
};
const excerpt = (b, n = 150) => {
  if (!b) return '';
  if (b.length <= n) return b;
  const cut = b.slice(0, n);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
};
---

<Base title="Faculty — Center for Anthroposophy" current="/faculty">
  <PageHeader
    eyebrow="Faculty"
    title="Our faculty"
    lede="One roster, filtered by program. Choose a program to see who teaches in it; select any name to read their full biography."
  />

  <section class="band">
    <div class="wrap">
      <div class="filters">
        <button class="fbtn is-on" data-filter="all">All active<span class="ct">{activeN}</span></button>
        {tags.map((t) => (
          <button class="fbtn" data-filter={t}>{TAG_LABEL[t]}<span class="ct">{tagCounts[t]}</span></button>
        ))}
      </div>
      <div class="archrow">
        Retired faculty kept on file: <button id="archToggle" type="button">Show archived ({archN})</button>
      </div>
      <p class="fcount" id="fcount"></p>

      <div class="fgrid">
        {people.map((p, i) => (
          <button
            class="fcard"
            type="button"
            data-programs={p.programs.join(' ')}
            data-active={p.active ? '1' : '0'}
            data-i={i}
          >
            <span class="avatar">
              {p.photo?.startsWith('/images/')
                ? <img src={p.photo} alt="" loading="lazy" width="60" height="60" />
                : <span class="avatar-init">{initials(p.name)}</span>}
            </span>
            <span class="fmeta">
              <span class="fname">{p.name}</span>
              <span class="chips">
                {p.active
                  ? p.programs.slice(0, 3).map((t) => <span class="chip">{TAG_LABEL[t] ?? t}</span>)
                  : <span class="chip arch">Archived</span>}
                {p.active && p.programs.length > 3 && <span class="chip more">+{p.programs.length - 3}</span>}
              </span>
              {p.bio && <span class="fexcerpt">{excerpt(p.bio)}</span>}
              {p.bio && <span class="fread">Read bio →</span>}
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* Full-bio modal */}
  <div id="bio-modal" class="modal" hidden aria-modal="true" role="dialog">
    <div class="modal-backdrop" data-close></div>
    <div class="modal-card" role="document">
      <button class="modal-close" type="button" data-close aria-label="Close">×</button>
      <div class="modal-head">
        <span class="modal-photo" id="m-photo"></span>
        <div>
          <h2 id="m-name"></h2>
          <div class="chips" id="m-chips"></div>
        </div>
      </div>
      <p class="modal-bio" id="m-bio"></p>
    </div>
  </div>

  <script is:inline define:vars={{ FAC: people, LABELS: TAG_LABEL }}>
    const cards = [...document.querySelectorAll('.fcard')];
    const btns = [...document.querySelectorAll('.fbtn')];
    const count = document.getElementById('fcount');
    const archToggle = document.getElementById('archToggle');
    const archN = cards.filter((c) => c.dataset.active === '0').length;
    let filter = 'all', showArch = false;

    function render() {
      let shown = 0;
      for (const c of cards) {
        const progs = (c.dataset.programs || '').split(' ').filter(Boolean);
        const active = c.dataset.active === '1';
        const vis = filter === 'all' ? active || showArch : progs.includes(filter);
        c.hidden = !vis;
        if (vis) shown++;
      }
      count.textContent =
        `${shown} ${shown === 1 ? 'person' : 'people'} shown` +
        (filter === 'all' ? (showArch ? ' — including archived' : ' — active faculty') : ' in this program');
    }
    function setFilter(f) {
      filter = btns.some((b) => b.dataset.filter === f) ? f : 'all';
      btns.forEach((b) => b.classList.toggle('is-on', b.dataset.filter === filter));
      render();
    }
    btns.forEach((b) => b.addEventListener('click', () => setFilter(b.dataset.filter)));
    archToggle.addEventListener('click', () => {
      showArch = !showArch;
      archToggle.textContent = showArch ? 'Hide archived' : `Show archived (${archN})`;
      if (filter !== 'all') setFilter('all'); else render();
    });

    // Modal
    const modal = document.getElementById('bio-modal');
    const mPhoto = document.getElementById('m-photo');
    const mName = document.getElementById('m-name');
    const mChips = document.getElementById('m-chips');
    const mBio = document.getElementById('m-bio');
    function initials(name) {
      const p = name.replace(/[^A-Za-z\s]/g, ' ').split(/\s+/).filter(Boolean);
      return p.length >= 2 ? (p[0][0] + p[p.length - 1][0]).toUpperCase() : (p[0] || '–').slice(0, 2).toUpperCase();
    }
    function openBio(i) {
      const p = FAC[i];
      if (!p) return;
      mPhoto.innerHTML = p.photo && p.photo.startsWith('/images/')
        ? `<img src="${p.photo}" alt="${p.name}">`
        : `<span class="avatar-init">${initials(p.name)}</span>`;
      mName.textContent = p.name;
      mChips.innerHTML = p.active
        ? p.programs.map((t) => `<span class="chip">${LABELS[t] || t}</span>`).join('')
        : '<span class="chip arch">Archived faculty</span>';
      mBio.textContent = p.bio || 'Biography coming soon.';
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      modal.querySelector('.modal-close').focus();
    }
    function closeBio() { modal.hidden = true; document.body.style.overflow = ''; }
    cards.forEach((c) => c.addEventListener('click', () => openBio(+c.dataset.i)));
    modal.addEventListener('click', (e) => { if (e.target.hasAttribute('data-close')) closeBio(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeBio(); });

    setFilter(new URLSearchParams(location.search).get('program') || 'all');
  </script>
</Base>

---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('spine', (e) => e.data.section === 'about');
  return pages.map((e) => ({ params: { slug: e.data.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.navLabel} — Center for Anthroposophy`} current="/about">
  <PageHeader eyebrow="About" title={entry.data.navLabel} />
  <article class="article">
    <div class="wrap">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

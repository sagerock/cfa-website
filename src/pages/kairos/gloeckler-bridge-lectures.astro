---
// Marketing lander for the Bridge Lectures with Dr. Michaela Glöckler (Kairos
// Institute public course, January–February 2027). Copy is taken from the
// WordPress page it replaces:
// https://centerforanthroposophy.org/the-bridge-lectures-with-dr-michaela-gloeckler/
//
// The checkout lives in src/components/KairosGloecklerCheckout.astro and is kept
// out of this file on purpose, the same split as /biografia: copy, layout and
// imagery can change here without touching the form that takes payment.
//
// Left noindex (the site default) while this is a review preview. Biografia opted
// into `indexable` only once it was live and on sale; do the same here when CfA
// says go and the WordPress page points to it.
import Base from '../../layouts/Base.astro';
import KairosGloecklerCheckout from '../../components/KairosGloecklerCheckout.astro';

const seminars = [
  { label: 'Seminar One', date: 'Sunday, January 24, 2027' },
  { label: 'Seminar Two', date: 'Sunday, February 14, 2027' },
  { label: 'Seminar Three', date: 'Sunday, February 21, 2027' },
];
---

<Base
  title="Register: The Bridge Lectures with Dr. Michaela Glöckler | Center for Anthroposophy"
  portalLabel={null}
  minimal
>
  <header class="registration-head">
    <div class="wrap registration-intro">
      <div>
        <p class="eyebrow series-link">Kairos Institute · The Bridge Lectures</p>
        <h1>Enthusiasm as Warmth to Counter the Cold of our Times</h1>
        <p class="cohort">Salutogenesis and the Power of Human Love</p>
        <p class="intro-copy">
          Three Sunday seminars with Dr. Michaela Glöckler, who led the Medical Section at
          the Goetheanum for twenty-eight years. On what keeps people well rather than what
          makes them ill, and on warmth as something a person can actually generate.
        </p>
        <p class="course-details">Three Sundays in January and February 2027<br />
          Each seminar in two parts, morning and afternoon</p>
        <p class="course-format">Online by Zoom · Six sessions in all</p>
        <a class="course-link" href="#registration-form">See registration details <span aria-hidden="true">↓</span></a>
      </div>
      <div class="when-card">
        <p class="eyebrow">The three seminars</p>
        <ol class="seminar-list">
          {seminars.map((seminar) => (
            <li>
              <span class="seminar-no">{seminar.label}</span>
              <strong>{seminar.date}</strong>
              <span class="seminar-parts">11:00 AM – 12:30 PM EST<br />1:30 – 3:00 PM EST</span>
            </li>
          ))}
        </ol>
        <p class="when-note">Each part runs an hour and a half.</p>
      </div>
    </div>
  </header>

  <section class="wrap facilitator-welcome" aria-labelledby="speaker-title">
    <img class="facilitator-photo" src="/images/6376fff370-dr-michaela-gloeckler-150x150-1.jpg"
      alt="Portrait of Dr. Michaela Glöckler."
      width="150" height="150" loading="lazy" />
    <div>
      <p class="eyebrow">Pediatrician · Medical Section, Goetheanum 1988–2016</p>
      <h2 id="speaker-title">Michaela Glöckler, M.D.</h2>
      <p>A graduate of the original Waldorf school in Stuttgart, Dr. Glöckler studied history
        and German in Freiburg and Heidelberg, and medicine in Tübingen and Marburg, while
        pursuing her own study of anthroposophy. She trained further as a pediatrician and
        adolescent physician at the Community Hospital in Herdecke and the University Hospital
        in Bochum, then worked as a pediatrician and as a school doctor in a Waldorf school.</p>
      <p>From 1988 to 2016 she led the Medical Section at the Goetheanum in Dornach,
        Switzerland, years that included extensive lecturing and the training of physicians at
        home and abroad. She co-founded the Alliance for Childhood and ELIANT, the European
        Alliance of Initiatives for Applied Anthroposophy.</p>
      <p>Her books in English include <em>Guide to Child Health</em>, <em>The Dignity of the
        Young Child</em>, <em>Ethical Considerations in Medicine</em>, <em>Education – Health
        for Life</em>, <em>Education as Preventive Medicine</em>, <em>Medicine at the
        Threshold</em>, and <em>Healing Education</em>.</p>
      <p class="welcome-credit">The Bridge Lectures close the Kairos Institute’s 2026–27 year,
        which opens with the convocation with Peter Selg in September. Questions about the
        course can go to Lisl Hofer at
        <a href="mailto:lisl@centerforanthroposophy.org">lisl@centerforanthroposophy.org</a>.</p>
    </div>
  </section>

  <KairosGloecklerCheckout />
</Base>

<style>
  .registration-head {
    border-bottom: 1px solid var(--line);
    background: linear-gradient(120deg, rgba(176, 136, 16, 0.12), transparent 62%);
    padding: 56px 0 48px;
  }
  .registration-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 48px;
    align-items: center;
  }
  .registration-head h1 {
    font-size: clamp(36px, 4.6vw, 58px);
    letter-spacing: -0.035em;
    margin-top: 6px;
  }
  .series-link { color: var(--green-ink); }
  .cohort {
    color: var(--gold);
    font-family: var(--sans);
    font-size: 18px;
    letter-spacing: 0.035em;
    margin-top: 14px;
  }
  .intro-copy { color: var(--soft); font-size: 20px; max-width: 52ch; margin-top: 24px; }
  .course-details { font: 600 16px/1.7 var(--sans); margin-top: 24px; }
  .course-format { color: var(--soft); font: 14px/1.7 var(--sans); margin-top: 8px; }
  .course-link { display: inline-flex; gap: 16px; margin-top: 24px; color: var(--green-ink); font: 600 15px var(--sans); text-underline-offset: 5px; }
  .course-link:focus-visible { outline: 2px solid var(--green); outline-offset: 6px; }
  .when-card { border: 1px solid var(--line); border-left: 3px solid var(--gold); background: var(--raised); padding: 26px 28px; min-width: 0; }
  .seminar-list { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 18px; }
  .seminar-list li { display: grid; gap: 2px; }
  .seminar-no { color: var(--gold); font: 11px var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .seminar-list strong { font-size: 19px; font-weight: 600; }
  .seminar-parts { color: var(--soft); font: 14px/1.7 var(--sans); }
  .when-note { color: var(--soft); font: 13px/1.6 var(--sans); margin-top: 16px; }
  .facilitator-welcome { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 36px; align-items: start; padding-top: 48px; padding-bottom: 48px; border-bottom: 1px solid var(--line); }
  .facilitator-photo { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; }
  .facilitator-welcome h2 { font-size: clamp(25px, 3vw, 34px); margin: 8px 0 16px; }
  .facilitator-welcome p { max-width: 68ch; margin-top: 12px; }
  .welcome-credit { color: var(--soft); font: 14px/1.6 var(--sans); margin-top: 20px; }

  @media (max-width: 820px) {
    .registration-intro { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (max-width: 560px) {
    .registration-head { padding: 38px 0 34px; }
    .facilitator-welcome { grid-template-columns: 1fr; gap: 22px; padding-top: 32px; padding-bottom: 32px; }
    .facilitator-photo { width: 110px; height: 110px; }
  }
</style>

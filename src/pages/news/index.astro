---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsGrid from '../../components/NewsGrid.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 24;
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const first = posts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
---

<Base title="News & Views — Center for Anthroposophy" current="/news">
  <PageHeader
    eyebrow="News & Views"
    title="News &amp; Views"
    lede={`Newsletters, announcements, and reflections from the Center — ${posts.length} in the archive.`}
  />
  <section class="band">
    <div class="wrap">
      <NewsGrid posts={first} />
      {totalPages > 1 && (
        <nav class="pager" aria-label="Pagination">
          <span class="disabled">← Newer</span>
          <span class="pager-count">Page 1 of {totalPages}</span>
          <a href="/news/page/2">Older →</a>
        </nav>
      )}
    </div>
  </section>
</Base>

---
import Learn from '../../layouts/Learn.astro';
import MuxVideo from '../../components/MuxVideo.astro';
import { starlightPilot } from '../../data/starlightPilot.js';
---

<Learn title={`${starlightPilot.title} — Learning Portal`}>
  <div id="course-loading" class="wrap course-state" role="status">Checking your Starlight Rays enrollment…</div>
  <div id="course-error" class="wrap course-state" hidden>
    <h1>Course access unavailable</h1>
    <p id="course-error-copy">We couldn’t load this course. Please return to your courses and try again.</p>
    <a href="/learn">Return to my courses</a>
  </div>

  <div id="course-content" hidden>
  <div class="course-hero">
    <div class="wrap">
      <a class="back" href="/learn">← My courses</a>
      <div class="course-hero-grid">
        <div>
          <p id="course-cohort" class="eyebrow"></p>
          <h1 id="course-title"></h1>
          <p id="course-subtitle" class="course-subtitle"></p>
        </div>
        <div class="facilitator">
          <span>Program Director</span>
          <strong id="course-facilitator"></strong>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap course-grid">
    <div class="course-main">
      <section class="next-session">
        <div class="next-kicker">
          <span class="live-dot"></span>
          Next live seminar
        </div>
        <p id="next-presenter" class="session-presenter"></p>
        <h2 id="next-title"></h2>
        <div class="session-time">
          <span id="next-date"></span>
          <span id="next-time"></span>
        </div>
        <a id="join-link" class="join-button" href="" target="_blank" rel="noopener" hidden>Join the live seminar</a>
        <button id="join-pending" class="join-button" type="button" disabled>Zoom link coming soon</button>
        <p class="privacy-note">This meeting link is available only after your enrollment is verified.</p>
      </section>

      <section class="curriculum" aria-labelledby="curriculum-title">
        <div class="section-title">
          <p class="eyebrow">Course path</p>
          <h2 id="curriculum-title">Seminars and recordings</h2>
        </div>
        <ol id="session-list" class="session-list"></ol>
      </section>

      <MuxVideo
        id="session-player"
        eyebrow="Session recordings"
        title="Secure video playback"
        emptyMessage="Recordings will appear here after the live seminars."
      />
    </div>

    <aside class="course-side">
      <section class="side-card welcome-card">
        <p class="eyebrow">Begin here</p>
        <h2>Welcome to Starlight Rays</h2>
        <p id="welcome-body" tabindex="-1" aria-live="polite">Your welcome letter and orientation will live here, available whenever you need them.</p>
        <button id="welcome-button" type="button" disabled>Welcome letter loading…</button>
      </section>

      <section class="side-card">
        <div class="side-title">
          <h2>Resources</h2>
          <span id="resource-count">0</span>
        </div>
        <ul id="resource-list" class="resource-list"></ul>
      </section>

      <section class="help-card">
        <span>Need help?</span>
        <p>Course questions go to the program team at <a href="mailto:office@centerforanthroposophy.org">office@centerforanthroposophy.org</a>. Technical trouble signing in or viewing sessions goes to <a href="mailto:sage@centerforanthroposophy.org">sage@centerforanthroposophy.org</a>.</p>
      </section>
    </aside>
  </div>
  </div>
</Learn>

<script>
  import { getCoursePayload, getPlaybackTokens } from '../../lib/learnClient.js';

  const dateFormat = new Intl.DateTimeFormat('en-US', {
    weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York',
  });
  const timeFormat = new Intl.DateTimeFormat('en-US', {
    hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York', timeZoneName: 'short',
  });
  const result = await getCoursePayload('starlight-rays-2026-2027');

  const durableToken = new URL(location.href).searchParams.get('k');
  if (result.status === 'signed_out') {
    location.replace(durableToken ? `/learn/go?k=${encodeURIComponent(durableToken)}` : '/learn/sign-in');
  } else if (result.status !== 'ok') {
    document.getElementById('course-loading').hidden = true;
    document.getElementById('course-error').hidden = false;
    if (result.status === 'forbidden') {
      document.getElementById('course-error-copy').textContent = 'This account does not have an active Starlight Rays enrollment.';
    }
  } else {
    const { course, learner, sessions, resources } = result.data;
    document.getElementById('course-cohort').textContent = course.cohort || 'Course';
    document.getElementById('course-title').textContent = course.title;
    document.getElementById('course-subtitle').textContent = course.subtitle || '';
    document.getElementById('course-facilitator').textContent = course.facilitator || '';
    document.getElementById('learn-person').textContent = learner.display_name;

    const now = Date.now();
    const validSessions = sessions.filter((session) => Number.isFinite(new Date(session.starts_at).getTime()));
    const next = validSessions.find((session) => new Date(session.ends_at || session.starts_at).getTime() >= now) || validSessions.at(-1);
    if (next) {
      const starts = new Date(next.starts_at);
      const ends = next.ends_at ? new Date(next.ends_at) : null;
      document.getElementById('next-presenter').textContent = next.presenter || '';
      document.getElementById('next-title').textContent = next.title;
      document.getElementById('next-date').textContent = dateFormat.format(starts);
      document.getElementById('next-time').textContent = ends
        ? `${timeFormat.format(starts).replace(/\s[A-Z]{3,4}$/, '')}–${timeFormat.format(ends)}`
        : timeFormat.format(starts);
      if (next.zoom_url?.startsWith('https://')) {
        const link = document.getElementById('join-link');
        link.href = next.zoom_url;
        link.hidden = false;
        document.getElementById('join-pending').hidden = true;
      }
    }

    const playerCard = document.getElementById('session-player');
    async function showRecording(session) {
      const playback = await getPlaybackTokens('starlight-rays-2026-2027', session.id);
      if (playback.status !== 'ok') return;
      const { playback_id, tokens } = playback.data;
      const src = `https://player.mux.com/${encodeURIComponent(playback_id)}`
        + `?playback-token=${encodeURIComponent(tokens.video)}`
        + `&thumbnail-token=${encodeURIComponent(tokens.thumbnail)}`
        + `&storyboard-token=${encodeURIComponent(tokens.storyboard)}`;
      let frame = playerCard.querySelector('iframe');
      if (!frame) {
        frame = document.createElement('iframe');
        frame.title = session.title;
        frame.allow = 'accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture';
        frame.allowFullscreen = true;
        frame.style.cssText = 'display:block;width:100%;aspect-ratio:16/9;border:0;background:#1b2720;';
        playerCard.querySelector('.video-empty')?.remove();
        playerCard.append(frame);
      }
      frame.src = src;
      playerCard.querySelector('[data-video-title]').textContent = session.title;
      playerCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    const sessionList = document.getElementById('session-list');
    validSessions.forEach((session, index) => {
      const item = document.createElement('li');
      if (session.id === next?.id) item.classList.add('active');
      const number = document.createElement('span');
      number.className = 'session-number';
      number.textContent = String(index + 1).padStart(2, '0');
      const copy = document.createElement('div');
      const state = document.createElement('span');
      state.className = 'session-state';
      state.textContent = session.id === next?.id ? 'Next session' : session.has_recording ? 'Recording available' : new Date(session.ends_at || session.starts_at).getTime() < now ? 'Recording coming soon' : 'Scheduled';
      const title = document.createElement('h3');
      title.textContent = session.title;
      const meta = document.createElement('p');
      meta.textContent = `${session.presenter || ''} · ${dateFormat.format(new Date(session.starts_at))}`;
      const arrow = document.createElement('span');
      arrow.className = 'session-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = session.has_recording ? '▶' : session.id === next?.id ? '→' : '·';
      copy.append(state, title, meta);
      item.append(number, copy, arrow);
      if (session.has_recording) {
        item.classList.add('has-recording');
        item.tabIndex = 0;
        item.setAttribute('role', 'button');
        item.setAttribute('aria-label', `Watch the recording of ${session.title}`);
        item.addEventListener('click', () => showRecording(session));
        item.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            showRecording(session);
          }
        });
      }
      sessionList.append(item);
    });

    const recorded = validSessions.filter((session) => session.has_recording);
    if (recorded.length) showRecording(recorded.at(-1));

    const resourceList = document.getElementById('resource-list');
    document.getElementById('resource-count').textContent = String(resources.length);
    resources.forEach((resource) => {
      const item = document.createElement('li');
      const icon = document.createElement('span');
      icon.className = 'resource-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = '↗';
      const copy = document.createElement('div');
      const title = document.createElement('strong');
      title.textContent = resource.title;
      const detail = document.createElement('span');
      detail.textContent = resource.kind === 'page' ? 'Course page' : 'Course resource';
      copy.append(title, detail);
      item.append(icon, copy);
      resourceList.append(item);
    });

    const welcome = resources.find((resource) => resource.kind === 'page' && resource.body);
    if (welcome) {
      const button = document.getElementById('welcome-button');
      button.disabled = false;
      button.textContent = 'Open welcome letter';
      button.addEventListener('click', () => {
        const body = document.getElementById('welcome-body');
        body.textContent = welcome.body;
        button.hidden = true;
        body.focus();
      });
    }

    document.getElementById('course-loading').hidden = true;
    document.getElementById('course-content').hidden = false;
  }
</script>

<style>
  [hidden] { display: none !important; }
  .course-state { max-width: 760px; min-height: 55vh; padding-top: 70px; color: var(--soft); }
  .course-state h1 { margin-bottom: 10px; color: var(--ink); font-size: 32px; }
  .course-hero { padding: 28px 0 42px; border-bottom: 1px solid var(--line); background: var(--raised); }
  .back { display: inline-block; margin-bottom: 26px; color: var(--soft); font-family: var(--sans); font-size: 12px; text-decoration: none; }
  .back:hover { color: var(--green-ink); }
  .course-hero-grid { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; }
  .course-hero h1 { margin: 6px 0 8px; font-size: clamp(42px, 8vw, 72px); letter-spacing: -.025em; }
  .course-subtitle { color: var(--soft); font-size: clamp(17px, 2.4vw, 21px); font-style: italic; }
  .facilitator { display: flex; flex-direction: column; min-width: 220px; padding-left: 18px; border-left: 2px solid var(--gold); font-family: var(--sans); }
  .facilitator span { color: var(--soft); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .facilitator strong { margin-top: 3px; font-size: 14px; }
  .course-grid { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 34px; padding-top: 38px; }
  .course-main { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .next-session { position: relative; overflow: hidden; padding: 28px 30px; border-radius: 7px; color: #edf2ec; background: #203128; box-shadow: 0 18px 45px -34px #000; }
  .next-session::after { content: ''; position: absolute; width: 250px; height: 250px; right: -110px; top: -140px; border: 1px solid rgba(127, 192, 163, .32); border-radius: 50%; box-shadow: 0 0 0 28px rgba(127, 192, 163, .04), 0 0 0 56px rgba(127, 192, 163, .025); }
  .next-kicker { display: flex; align-items: center; gap: 8px; color: #a9cbb8; font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: #e4c05c; box-shadow: 0 0 0 4px rgba(228, 192, 92, .13); }
  .session-presenter { margin-top: 25px; color: #a9cbb8; font-family: var(--sans); font-size: 13px; }
  .next-session h2 { max-width: 25ch; margin: 7px 0 19px; font-size: clamp(24px, 4vw, 34px); }
  .session-time { display: flex; gap: 7px 22px; flex-wrap: wrap; color: #cad6ce; font-family: var(--sans); font-size: 13px; }
  .join-button, .welcome-card button { display: inline-block; margin-top: 25px; border: 1px solid rgba(255, 255, 255, .3); border-radius: 3px; padding: 10px 15px; color: #b5c2ba; background: rgba(255,255,255,.05); font-family: var(--sans); font-size: 12px; text-decoration: none; }
  a.join-button { color: #fff8ec; background: #b07e22; border-color: #b07e22; font-weight: 600; }
  .privacy-note { margin-top: 9px; color: #8da095; font-family: var(--sans); font-size: 11px; }
  .curriculum { padding: 7px 0; }
  .section-title { margin-bottom: 17px; }
  .section-title h2 { margin-top: 5px; font-size: 27px; }
  .session-list { list-style: none; border-top: 1px solid var(--line); }
  .session-list li { display: grid; grid-template-columns: 45px 1fr 24px; gap: 15px; align-items: center; padding: 19px 4px; border-bottom: 1px solid var(--line); }
  .session-list li.active { background: linear-gradient(90deg, var(--chalk), transparent); }
  .session-list li.has-recording { cursor: pointer; }
  .session-list li.has-recording:hover, .session-list li.has-recording:focus-visible { background: linear-gradient(90deg, var(--chalk), transparent); }
  .session-number { color: var(--soft); font-family: var(--sans); font-size: 11px; font-variant-numeric: tabular-nums; }
  .session-state { color: var(--green-ink); font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .session-list h3 { margin: 3px 0 4px; font-size: 17px; line-height: 1.3; }
  .session-list p { color: var(--soft); font-family: var(--sans); font-size: 11.5px; }
  .session-arrow { color: var(--green-ink); font-family: var(--sans); font-size: 18px; }
  .course-side { display: flex; flex-direction: column; gap: 17px; }
  .side-card { padding: 20px; border: 1px solid var(--line); border-radius: 7px; background: var(--raised); }
  .side-card h2 { font-size: 19px; }
  .welcome-card { border-top: 3px solid var(--gold); }
  .welcome-card h2 { margin: 6px 0 9px; font-size: 22px; }
  .welcome-card p { color: var(--soft); font-size: 14px; line-height: 1.5; white-space: pre-line; }
  .welcome-card button { width: 100%; margin-top: 17px; border-color: var(--line); color: var(--soft); background: var(--paper); }
  .side-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .side-title span { display: grid; place-items: center; width: 23px; height: 23px; border-radius: 50%; color: var(--green-ink); background: var(--chalk); font-family: var(--sans); font-size: 11px; }
  .resource-list { list-style: none; }
  .resource-list li { display: flex; gap: 10px; padding: 12px 0; border-top: 1px dotted var(--line); }
  .resource-icon { color: var(--green-ink); font-family: var(--sans); }
  .resource-list div { display: flex; flex-direction: column; }
  .resource-list strong { font-family: var(--sans); font-size: 12px; line-height: 1.4; }
  .resource-list div span { color: var(--soft); font-family: var(--sans); font-size: 10.5px; }
  .help-card { padding: 4px 8px; color: var(--soft); font-family: var(--sans); font-size: 11.5px; }
  .help-card > span { color: var(--ink); font-size: 12px; font-weight: 600; }
  .help-card p { margin: 5px 0; line-height: 1.5; }
  @media (max-width: 820px) {
    .course-hero-grid { align-items: flex-start; flex-direction: column; }
    .course-grid { grid-template-columns: 1fr; }
    .course-side { display: grid; grid-template-columns: 1fr 1fr; }
    .help-card { grid-column: 1 / -1; }
  }
  @media (max-width: 580px) {
    .course-side { display: flex; }
    .next-session { padding: 23px 21px; }
    .session-list li { grid-template-columns: 32px 1fr 16px; gap: 9px; }
  }
</style>

---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import ThirdPartyTags from '../components/ThirdPartyTags.astro';
// minimal: standalone chrome for pilot-facing pages (registration) — no site
// navigation, logo points at the live public site, slim footer. The rebuilt
// site stays unreachable from the pilot until it launches.
const {
  title = 'Center for Anthroposophy',
  current = '',
  minimal = false,
  publication = false,
  lang = 'en',
  portalLabel = 'Already registered? Sign in',
  // Registration pages carry a sign-in link because most CfA programs hand the
  // buyer a portal. Pass portalLabel={null} for one that does not — a live Zoom
  // course with no recordings has nothing behind a sign-in, and offering one
  // sends a new registrant somewhere empty.
  noindex = false,
  // The rebuilt site is noindex by default and stays that way until it launches.
  // A single page that is genuinely public before then opts in with indexable —
  // biografia is the first: it is a live, on-sale course linked from the WordPress
  // home page, and Spanish-speaking buyers have to be able to find it in search.
  // noindex still wins if both are passed.
  indexable = false,
} = Astro.props;
const liveSite = 'https://centerforanthroposophy.org';
const publicationSite = 'https://news.centerforanthroposophy.org';
const nav = publication ? [
  [`${liveSite}/programs/`, 'Programs'],
  [`${liveSite}/about/faculty/`, 'Faculty'],
  ['/center-periphery', 'Center & Periphery'],
  [`${liveSite}/about/`, 'About'],
] : [
  ['/programs', 'Programs'],
  ['/faculty', 'Faculty'],
  ['/calendar', 'Calendar'],
  ['/news', 'News'],
  ['/about', 'About'],
];
const canonical = publication
  ? `${publicationSite}${Astro.url.pathname}`
  : null;
const year = new Date().getFullYear();
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={!noindex && (publication || indexable) ? 'index, follow, max-image-preview:large' : 'noindex'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <ThirdPartyTags />
    <script is:inline>
      if (location.hostname === 'learn.centerforanthroposophy.org' && location.pathname === '/') {
        location.replace('/learn');
      }
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap head-top">
        <span>Discover your destiny, practice your passion.</span>
      </div>
      <div class="wrap head-main">
        <a class="brand" href={minimal || publication ? liveSite : '/'}>
          <img class="brand-logo" src="/images/cfa-logo-2024.png" alt="Center for Anthroposophy" width="532" height="344" />
        </a>
        {minimal && portalLabel && (
          <a class="btn-contact" id="portal-link" href="/learn/sign-in">{portalLabel}</a>
        )}
        {!minimal && (
          <div class="head-right">
            <nav class="nav" aria-label="Main">
              {nav.map(([href, label]) => (
                <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>
              ))}
            </nav>
            <div class="head-actions">
              <a class="btn-info" href={publication ? `${liveSite}/contact-us/` : '/contact'} data-track="header-contact"
                 aria-current={current === '/contact' ? 'page' : undefined}>Request Info</a>
              <a class="btn-contact" href={publication ? `${liveSite}/make-a-donation/` : '/donate'} data-track="header-donate"
                 aria-current={current === '/donate' ? 'page' : undefined}>Donate</a>
            </div>
          </div>
        )}
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      {!minimal && (
      <div class="wrap foot-grid">
        <div class="foot-col foot-brand">
          <img class="brand-logo foot-logo" src="/images/cfa-logo-2024.png" alt="Center for Anthroposophy" width="532" height="344" loading="lazy" />
          <p class="foot-mission">
            Leading teacher training, healing, and research since 1996.
          </p>
          <address>
            Center for Anthroposophy<br />
            PO Box 545, Wilton, NH 03086<br />
            <a href="tel:+16036542566">603-654-2566</a><br />
            <a href="mailto:office@centerforanthroposophy.org">office@centerforanthroposophy.org</a>
          </address>
        </div>

        <div class="foot-col">
          <h3 class="foot-tag">Programs</h3>
          <ul>
            <li><a href="/programs/explorations-online">Explorations Online</a></li>
            <li><a href="/programs/building-bridges">Building Bridges</a></li>
            <li><a href="/programs/waldorf-high-school">High School Teacher Education</a></li>
            <li><a href="/programs/antioch-university">Antioch University Program</a></li>
            <li><a href="/programs/kairos-institute">Kairos Institute</a></li>
            <li><a href="/programs/mentor-training">Mentor Training</a></li>
            <li><a href="/programs/renewal-courses">Renewal Courses</a></li>
            <li><a href="/programs/waldorf-leadership-development">Leadership Development</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <h3 class="foot-tag">About</h3>
          <ul>
            <li><a href="/about/about-the-center">About the Center</a></li>
            <li><a href="/about/becoming-a-waldorf-teacher">Becoming a Waldorf Teacher</a></li>
            <li><a href="/about/our-history">Our History</a></li>
            <li><a href="/faculty">Faculty</a></li>
            <li><a href="/about/board-and-administration">Board &amp; Administration</a></li>
            <li><a href="/about/commitment-to-dei">Commitment to DEI</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <h3 class="foot-tag">More</h3>
          <ul>
            <li><a href="/donate">Support the Center</a></li>
            <li><a href="/programs/summer-housing-meals">Summer Housing &amp; Meals</a></li>
            <li><a href="/about/goetheanum">The Goetheanum</a></li>
            <li><a href="/about/rudolf-steiner">Rudolf Steiner</a></li>
          </ul>
        </div>
      </div>
      )}
      <div class="foot-bottom">
        <div class="wrap">
          <span>© {year} Center for Anthroposophy</span>
          {minimal && (
            <span>
              <a href="mailto:office@centerforanthroposophy.org">office@centerforanthroposophy.org</a>
              &nbsp;·&nbsp;
              <a href="tel:+16036542566">603-654-2566</a>
            </span>
          )}
        </div>
      </div>
    </footer>
    <Analytics />
  </body>
</html>

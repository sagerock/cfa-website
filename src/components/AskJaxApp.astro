---
import '../styles/global.css';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
// Ask Jax as a full-page chat (Sage, 2026-10-11: "an actual chat window like ChatGPT",
// better on phones than a corner pop-up). Same widget script as the pop-up, mounted
// inline with data-mount. Used by /concierge (staff test, test=true: sessions tagged as
// test traffic) and /ask (the public address, unlinked until launch).
interface Props { test?: boolean }
const { test = false } = Astro.props;
// The script URL carries a hash of its contents, so a browser holding an older
// copy (it is cached for a while) fetches the new one as soon as it changes.
const widgetVersion = createHash('sha256')
  .update(readFileSync(join(process.cwd(), 'public/concierge/widget.js')))
  .digest('hex').slice(0, 10);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{test ? 'Ask Jax (test)' : 'Ask Jax'} | Center for Anthroposophy</title>
    <link rel="icon" href="/images/cfa-logo-2024.png" />
  </head>
  <body class="ask-body">
    <div class="ask-app">
      <header class="ask-bar">
        <a class="ask-brand" href="https://centerforanthroposophy.org/">
          <img src="/images/cfa-logo-2024.png" alt="Center for Anthroposophy" width="532" height="344" />
        </a>
        <div class="ask-title">
          <h1>Ask Jax {test && <span class="ask-test">test</span>}</h1>
          <p>CfA’s AI assistant for registrations &amp; payments</p>
        </div>
        <details class="ask-about">
          <summary>What can Jax do?</summary>
          <div class="ask-about-body">
            <p><strong>Jax can</strong> suggest a program that fits you, give current prices, check a discount
              code you already have, and hand you a sign-up link that's already filled in. After you confirm your
              email with a six-digit code, Jax can show your registration, your next Zoom link and your payment
              plan, or send a fresh sign-in link.</p>
            <p><strong>Jax can't</strong> take payments, decide refunds, scholarships or admissions, or teach
              course content. Kairos questions go to Lisl Hofer and Karine Munk Finser. Anything else is passed to
              a person at CfA.</p>
            <p>Every conversation is saved, and CfA staff can read them.{test && ' Conversations on this page are marked as tests.'}</p>
          </div>
        </details>
      </header>
      <main id="ask-chat" class="ask-chat"></main>
    </div>
    <script is:inline src={`/concierge/widget.js?v=${widgetVersion}`} data-mount="#ask-chat" data-concierge-test={test ? "" : undefined} defer></script>

    <style is:global>
      html, body.ask-body { height: 100%; margin: 0; }
      body.ask-body { background: var(--paper); overflow: hidden; }
      .ask-app { display: flex; flex-direction: column; height: 100vh; height: 100dvh; }
      .ask-bar { align-items: center; background: var(--raised); border-bottom: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 8px 16px; position: relative; }
      .ask-brand img { display: block; height: 40px; width: auto; }
      .ask-title { flex: 1; min-width: 0; }
      .ask-title h1 { font-size: 20px; line-height: 1.1; margin: 0; }
      .ask-title p { color: var(--soft); font: 12.5px var(--sans); margin: 2px 0 0; }
      .ask-test { border: 1px solid var(--line); border-radius: 999px; color: var(--soft); font: 10px var(--sans); letter-spacing: .06em; padding: 1px 7px; text-transform: uppercase; vertical-align: middle; }
      .ask-about { font: 13px var(--sans); }
      .ask-about summary { color: var(--green-ink); cursor: pointer; list-style: none; padding: 6px 0; }
      .ask-about summary::-webkit-details-marker { display: none; }
      .ask-about[open] .ask-about-body { background: var(--raised); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.15); max-width: 460px; padding: 14px 16px; position: absolute; right: 12px; top: 100%; z-index: 10; }
      .ask-about-body p { line-height: 1.5; margin: 0 0 10px; }
      .ask-about-body p:last-child { color: var(--soft); margin-bottom: 0; }
      .ask-chat { flex: 1; min-height: 0; padding-bottom: env(safe-area-inset-bottom); }
      @media (max-width: 560px) {
        .ask-brand img { height: 32px; }
        .ask-title p { display: none; }
        .ask-about[open] .ask-about-body { left: 8px; right: 8px; max-width: none; }
      }
    </style>
  </body>
</html>

---
import Learn from '../../layouts/Learn.astro';
---

<Learn current="/learn">
  <div id="learn-loading" class="wrap learn-state" role="status">Opening your learning space…</div>
  <div id="learn-denied" class="wrap learn-state" hidden>
    <h1>No active courses</h1>
    <p>You’re signed in, but this account does not have an active course enrollment. If that looks wrong — you may have signed in with a different email than you registered under — email <a href="mailto:sage@centerforanthroposophy.org">sage@centerforanthroposophy.org</a>.</p>
  </div>
  <div id="learn-error" class="wrap learn-state" hidden>
    <h1>We couldn’t load your courses</h1>
    <p>Please refresh the page or try again in a few minutes.</p>
  </div>

  <div id="learn-content" class="wrap learn-home" hidden>
    <header class="learn-intro">
      <p class="eyebrow">Student home</p>
      <h1>Your learning space</h1>
      <p>Live sessions, recordings, and course resources gathered in one quiet place.</p>
    </header>

    <section class="course-section" aria-labelledby="current-courses">
      <div class="section-heading">
        <div>
          <p class="eyebrow">In progress</p>
          <h2 id="current-courses">Your courses</h2>
        </div>
        <span id="course-count"></span>
      </div>

      <div id="course-list" class="course-list"></div>
    </section>
  </div>
</Learn>

<script>
  import { getMyCourses } from '../../lib/learnClient.js';

  const dateFormat = new Intl.DateTimeFormat('en-US', {
    month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/New_York',
  });
  const result = await getMyCourses();
  if (result.status === 'signed_out') {
    const durableToken = new URL(location.href).searchParams.get('k');
    location.replace(durableToken ? `/learn/go?k=${encodeURIComponent(durableToken)}` : '/learn/sign-in');
  } else {
    document.getElementById('learn-loading').hidden = true;
    if (result.status !== 'ok') {
      document.getElementById('learn-error').hidden = false;
    } else if (!result.data.courses.length) {
      document.getElementById('learn-denied').hidden = false;
    } else {
      const { courses, learner } = result.data;
      document.getElementById('learn-person').textContent = learner.display_name;
      document.getElementById('course-count').textContent =
        courses.length === 1 ? '1 course' : `${courses.length} courses`;
      const list = document.getElementById('course-list');
      for (const course of courses) {
        const card = document.createElement('a');
        card.className = 'course-card';
        card.href = `/learn/${course.slug}`;
        const image = document.createElement('img');
        image.alt = '';
        image.src = course.image_url?.startsWith('/')
          ? course.image_url
          : '/images/posts/e54997f7cf-thechallengeofinnerbalancehorizontal1.jpg';
        const copy = document.createElement('div');
        copy.className = 'course-card-copy';
        const term = document.createElement('span');
        term.className = 'course-term';
        term.textContent = course.published ? (course.cohort || 'Course') : `${course.cohort || 'Course'} · staff preview`;
        const title = document.createElement('h3');
        title.textContent = course.title;
        const subtitle = document.createElement('p');
        subtitle.textContent = course.subtitle || '';
        const meta = document.createElement('p');
        meta.className = 'course-meta';
        meta.textContent = [
          course.facilitator,
          course.expires_at ? `Access through ${dateFormat.format(new Date(course.expires_at))}` : '',
        ].filter(Boolean).join(' · ');
        const go = document.createElement('span');
        go.className = 'continue';
        go.append('Open course ');
        const arrow = document.createElement('b');
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '→';
        go.append(arrow);
        copy.append(term, title, subtitle, meta, go);
        card.append(image, copy);
        list.append(card);
      }
      document.getElementById('learn-content').hidden = false;
    }
  }
</script>

<style is:global>
  /* Global: the course cards are built in JavaScript (scoped styles miss them). */
  .learn-state { max-width: 760px; padding-top: 70px; min-height: 52vh; color: var(--soft); }
  .learn-state h1 { margin-bottom: 10px; color: var(--ink); font-size: 32px; }
  .learn-home { padding-top: 54px; }
  .learn-intro { max-width: 680px; }
  .learn-intro h1 { margin: 7px 0 11px; font-size: clamp(34px, 6vw, 55px); }
  .learn-intro > p:last-child { color: var(--soft); font-size: 19px; max-width: 52ch; }
  .learn-home .preview-note { margin: 30px 0 52px; max-width: 760px; border-left: 3px solid var(--gold); padding: 12px 16px; background: var(--raised); color: var(--soft); font-family: var(--sans); font-size: 13px; }
  .preview-note strong { display: block; color: var(--ink); margin-bottom: 2px; }
  .course-section { max-width: 850px; margin-top: 48px; }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; }
  .section-heading h2 { margin-top: 3px; font-size: 25px; }
  .section-heading > span { color: var(--soft); font-family: var(--sans); font-size: 12px; }
  .course-card { display: grid; grid-template-columns: minmax(240px, .8fr) 1.2fr; overflow: hidden; border: 1px solid var(--line); border-radius: 7px; background: var(--raised); color: var(--ink); text-decoration: none; transition: transform .15s, border-color .15s; }
  .course-card:hover { transform: translateY(-2px); border-color: var(--green); }
  .course-card img { width: 100%; height: 100%; min-height: 220px; object-fit: cover; }
  .course-card-copy { display: flex; flex-direction: column; align-items: flex-start; padding: 30px; }
  .course-term { color: var(--green-ink); font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .course-card h3 { margin: 12px 0 6px; font-size: 34px; }
  .course-card p { color: var(--soft); font-size: 16px; }
  .course-list { display: flex; flex-direction: column; gap: 18px; }
  .course-meta { margin-top: 10px; font-family: var(--sans); font-size: 12px !important; }
  .continue { margin-top: auto; padding-top: 18px; color: var(--green-ink); font-family: var(--sans); font-size: 13px; font-weight: 600; }
  .continue b { margin-left: 4px; }
  @media (max-width: 680px) {
    .learn-home { padding-top: 36px; }
    .course-card { grid-template-columns: 1fr; }
    .course-card img { height: 190px; min-height: 0; }
    .course-card-copy { min-height: 280px; padding: 24px; }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { analyzeEditions } from '../../data/newsHelpers.js';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const { editions, memberOf } = analyzeEditions(posts);
  return posts.map((entry) => {
    const edSlug = memberOf[entry.data.slug];
    const edition = edSlug && edSlug !== entry.data.slug ? editions[edSlug] : null;
    // an edition cover opens at its first article — the sidebar carries the TOC
    const redirectTo = editions[entry.data.slug]?.articles[0]?.slug ?? null;
    return { params: { slug: entry.data.slug }, props: { entry, edition, redirectTo } };
  });
}

const { entry, edition, redirectTo } = Astro.props;
const { Content } = await render(entry);
const fmtDate = (d) =>
  new Date(d + 'T00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<Base
  title={`${entry.data.title} — Center for Anthroposophy`}
  current={edition ? '/center-periphery' : '/news'}
  publication={Boolean(edition)}
>
  {redirectTo && <meta http-equiv="refresh" content={`0;url=/news/${redirectTo}`} />}
  <article class="article">
    <div class="wrap">
      {edition ? (
        <div class="news-layout">
          <aside class="news-side">
            <p class="side-eyebrow">In this edition</p>
            <span class="side-edition">{edition.title}</span>
            <ul>
              {edition.articles.map((a) => (
                <li class={a.slug === entry.data.slug ? 'current' : ''}>
                  {a.slug === entry.data.slug
                    ? <span>{a.title}</span>
                    : <a href={`/news/${a.slug}`}>{a.title}</a>}
                </li>
              ))}
            </ul>
            <a class="side-all" href="/center-periphery">← All Center &amp; Periphery</a>
          </aside>
          <div class="news-main">
            <header class="post-head">
              <time class="news-date">{fmtDate(entry.data.date)}</time>
              <h1>{entry.data.title}</h1>
            </header>
            <div class="prose"><Content /></div>
          </div>
        </div>
      ) : (
        <div class="news-single">
          <p class="backlink"><a href="/news">← All News &amp; Views</a></p>
          <header class="post-head">
            <time class="news-date">{fmtDate(entry.data.date)}</time>
            <h1>{entry.data.title}</h1>
          </header>
          <div class="prose"><Content /></div>
        </div>
      )}
    </div>
  </article>
</Base>

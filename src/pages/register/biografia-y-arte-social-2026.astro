---
// VISTA PREVIA / PREVIEW ONLY. Static mock of a Spanish-language registration page for
// the Biography and Social Art course (Magnolia Ríos, fall 2026). Not wired to
// cfa-register yet: no program row, no offers, no payment. Price is unconfirmed.
import Base from '../../layouts/Base.astro';

const sessions = [
  { date: '7 de octubre', topic: 'Cualidades planetarias. Introducción y el Sol, el armonizador' },
  { date: '14 de octubre', topic: 'El Sol. Cualidades, preguntas de vida, diario y puesta en común' },
  { date: '21 de octubre', topic: 'Los que mueven: Mercurio' },
  { date: '28 de octubre', topic: 'Los que mueven: Júpiter' },
  { date: '4 de noviembre', topic: 'Conversación y relación: Venus' },
  { date: '11 de noviembre', topic: 'Conversación y relación: Marte' },
  { date: '18 de noviembre', topic: 'Los planetas umbral: la Luna' },
  { date: '25 de noviembre', topic: 'Los planetas umbral: Saturno' },
];
---

<Base title="Inscripción: Biografía y Arte Social 2026 | Center for Anthroposophy" minimal>
  <header class="registration-head">
    <div class="wrap registration-intro">
      <div>
        <p class="eyebrow series-link">Curso en línea en español · Otoño 2026</p>
        <h1>Biografía y Arte Social</h1>
        <p class="cohort">Las fuerzas planetarias y su influencia en nuestra biografía</p>
      </div>
      <p class="intro-copy">
        Ocho encuentros en vivo por Zoom con Magnolia Ríos, los miércoles de 7:00 a 8:30 pm
        (hora del Este de EE. UU.), del 7 de octubre al 25 de noviembre de 2026. Un grupo
        pequeño, de 8 a 15 participantes. Incluye el acceso en vivo, las grabaciones y los
        materiales del curso.
      </p>
    </div>
  </header>

  <div class="wrap registration-layout">
    <main class="registration-main">
      <div class="sandbox-note">
        <strong>Vista previa</strong>
        Esta página es un borrador para revisión interna. La inscripción y el pago se
        activarán cuando se confirme el precio del curso.
      </div>

      <form id="registration-form" novalidate>
        <fieldset class="form-section">
          <legend><span>01</span> Elige tu inscripción</legend>
          <div class="offer-list">
            <label class="offer-option">
              <input type="radio" name="offer_code" value="curso-completo" checked />
              <span class="offer-copy">
                <strong>Curso completo · 8 sesiones</strong>
                <small>Las cuatro series de talleres: el Sol; Mercurio y Júpiter; Venus y Marte; la Luna y Saturno. Con verso, dibujo de formas, ejercicio artístico, preguntas de vida y puesta en común en cada encuentro.</small>
              </span>
              <span class="offer-price">Precio por confirmar</span>
            </label>
          </div>
          <div class="coupon-row">
            <label class="coupon-label">
              Código de descuento <small>opcional</small>
              <input type="text" maxlength="40" autocomplete="off" autocapitalize="characters" disabled />
            </label>
            <button class="coupon-apply" type="button" disabled>Aplicar</button>
          </div>
        </fieldset>

        <fieldset class="form-section">
          <legend><span>02</span> Datos del participante</legend>
          <div class="field-grid">
            <label for="participant-first-name">
              Nombre
              <input type="text" id="participant-first-name" name="first_name" autocomplete="given-name" maxlength="100" required />
            </label>
            <label for="participant-last-name">
              Apellidos
              <input type="text" id="participant-last-name" name="last_name" autocomplete="family-name" maxlength="100" required />
            </label>
            <label class="wide" for="participant-email">
              Correo electrónico
              <input type="email" id="participant-email" name="email" autocomplete="email" maxlength="254" required />
              <span>Usarás esta dirección para entrar al portal del curso.</span>
            </label>
            <label for="participant-phone">
              Teléfono <small>opcional</small>
              <input type="tel" id="participant-phone" name="phone" autocomplete="tel" maxlength="50" />
            </label>
            <label for="participant-organization">
              Escuela o institución <small>opcional</small>
              <input type="text" id="participant-organization" name="organization" autocomplete="organization" maxlength="200" />
            </label>
          </div>
        </fieldset>

        <fieldset class="form-section">
          <legend><span>03</span> Dirección de facturación</legend>
          <div class="field-grid">
            <label class="wide" for="billing-address1">
              Calle y número
              <input type="text" id="billing-address1" name="address1" autocomplete="billing street-address" maxlength="200" required />
            </label>
            <label for="billing-city">
              Ciudad
              <input type="text" id="billing-city" name="city" autocomplete="billing address-level2" maxlength="100" required />
            </label>
            <label for="billing-state">
              Estado o provincia
              <input type="text" id="billing-state" name="state" autocomplete="billing address-level1" maxlength="100" required />
            </label>
            <label for="billing-zip">
              Código postal
              <input type="text" id="billing-zip" name="zip" autocomplete="billing postal-code" maxlength="30" required />
            </label>
            <label for="billing-country">
              País
              <select id="billing-country" name="country" autocomplete="billing country" required>
                <option value="US">Estados Unidos</option>
                <option value="MX">México</option>
                <option value="AR">Argentina</option>
                <option value="CL">Chile</option>
                <option value="CO">Colombia</option>
                <option value="PE">Perú</option>
                <option value="ES">España</option>
                <option value="CA">Canadá</option>
                <option value="OTHER">Otro</option>
              </select>
            </label>
          </div>
        </fieldset>

        <fieldset class="form-section final-section">
          <legend><span>04</span> Confirmar y pagar</legend>
          <label class="check-row">
            <input type="checkbox" name="terms_accepted" required />
            <span>Autorizo el cargo seleccionado y entiendo que la inscripción está sujeta a la política de cancelación del Center for Anthroposophy. <a href="/policies/cancellation/" target="_blank" rel="noopener">Leer la política de cancelación</a>.</span>
          </label>
          <label class="check-row">
            <input type="checkbox" name="marketing_opt_in" />
            <span>Quiero recibir noticias ocasionales sobre los programas del Center for Anthroposophy.</span>
          </label>
          <button class="payment-button" type="button" disabled>
            Vista previa: el pago aún no está disponible
          </button>
          <p class="payment-note">Los datos de la tarjeta se procesan de forma segura a través de Authorize.Net y nunca pasan por este sitio web.</p>
        </fieldset>
      </form>
    </main>

    <aside class="registration-summary" aria-labelledby="summary-title">
      <div class="summary-card">
        <p class="eyebrow">Resumen de inscripción</p>
        <h2 id="summary-title">Tu selección</h2>
        <dl>
          <div>
            <dt>Programa</dt>
            <dd>Biografía y Arte Social 2026</dd>
          </div>
          <div>
            <dt>Formato</dt>
            <dd>En línea por Zoom, en español</dd>
          </div>
          <div>
            <dt>Fechas</dt>
            <dd>8 miércoles, del 7 de octubre al 25 de noviembre, 7:00 a 8:30 pm ET</dd>
          </div>
          <div>
            <dt>Facilitadora</dt>
            <dd>Magnolia Ríos</dd>
          </div>
          <div>
            <dt>Inscripción</dt>
            <dd>Curso completo</dd>
          </div>
        </dl>
        <div class="summary-total">
          <span>Total</span>
          <strong>Por confirmar</strong>
        </div>
      </div>
      <div class="summary-card sessions-card">
        <p class="eyebrow">Calendario</p>
        <h2>Las ocho sesiones</h2>
        <ol class="session-list">
          {sessions.map((session) => (
            <li><strong>{session.date}</strong><span>{session.topic}</span></li>
          ))}
        </ol>
        <p class="session-note">Distribución provisional de los cuatro talleres en ocho encuentros, pendiente de confirmar con Magnolia.</p>
      </div>
      <div class="support-card">
        <p>¿Preguntas antes de inscribirte?</p>
        <a href="mailto:office@centerforanthroposophy.org">office@centerforanthroposophy.org</a>
        <a href="tel:+16036542566">603-654-2566</a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .registration-head {
    border-bottom: 1px solid var(--line);
    background: linear-gradient(120deg, rgba(46, 94, 78, 0.1), transparent 62%);
    padding: 56px 0 48px;
  }
  .registration-intro {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(300px, 1.1fr);
    gap: 72px;
    align-items: end;
  }
  .registration-head h1 {
    font-size: clamp(44px, 7vw, 78px);
    letter-spacing: -0.045em;
    margin-top: 6px;
  }
  .series-link { color: var(--green-ink); text-decoration: none; }
  .series-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .cohort {
    color: var(--gold);
    font-family: var(--sans);
    font-size: 18px;
    letter-spacing: 0.14em;
    margin-top: 4px;
  }
  .intro-copy { color: var(--soft); font-size: 20px; max-width: 48ch; }
  .registration-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 56px;
    padding-top: 56px;
    padding-bottom: 96px;
    align-items: start;
  }
  .registration-main { min-width: 0; }
  .sandbox-note {
    border: 1px solid var(--gold);
    background: color-mix(in srgb, var(--gold) 10%, var(--raised));
    padding: 12px 16px;
    margin-bottom: 28px;
    font-family: var(--sans);
    font-size: 14px;
  }
  .sandbox-note strong { margin-right: 10px; }
  .form-section { border: 0; border-top: 1px solid var(--line); padding: 30px 0 42px; }
  .form-section legend {
    font-size: 25px;
    font-weight: 600;
    padding-right: 18px;
  }
  .form-section legend > span:first-child {
    color: var(--gold);
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.16em;
    margin-right: 12px;
    vertical-align: middle;
  }
  .form-section legend .legend-label { color: inherit; font: inherit; letter-spacing: inherit; margin: 0; }
  .offer-list { display: grid; gap: 12px; margin-top: 24px; }
  :global(.offer-option) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
    border: 1px solid var(--line);
    background: var(--raised);
    padding: 18px 20px;
    cursor: pointer;
  }
  :global(.offer-option:has(input:checked)) { border-color: var(--green); box-shadow: inset 4px 0 var(--green); }
  :global(.offer-option input) { accent-color: var(--green); width: 18px; height: 18px; }
  :global(.offer-copy) { display: grid; gap: 3px; }
  :global(.offer-copy strong), :global(.offer-price) { font-family: var(--sans); }
  :global(.offer-copy small) { color: var(--soft); font-size: 15px; }
  :global(.offer-price) { font-size: 19px; font-weight: 650; }
  :global(.offer-divider) { margin: 18px 0 6px; padding-top: 14px; border-top: 1px solid var(--rule, #e6e1d8); color: var(--soft); font-family: var(--serif); font-size: 15px; font-style: italic; }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 24px; }
  #organization-field[hidden] { display: none; }
  .field-grid label { display: grid; gap: 7px; font-family: var(--sans); font-size: 14px; font-weight: 600; }
  .field-grid label small { color: var(--soft); font-weight: 400; }
  .field-grid label > span { color: var(--soft); font-family: var(--serif); font-size: 14px; font-weight: 400; }
  .field-grid .wide { grid-column: 1 / -1; }
  input, select {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--raised);
    color: var(--ink);
    font: 16px var(--sans);
    padding: 12px 13px;
  }
  input:focus, select:focus { outline: 2px solid var(--green); outline-offset: 2px; }
  .check-row {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    align-items: start;
    margin-top: 22px;
    color: var(--soft);
    font-size: 15px;
  }
  .check-row input { width: 18px; height: 18px; margin-top: 4px; accent-color: var(--green); }
  .payment-button {
    width: 100%;
    border: 0;
    background: var(--green);
    color: var(--paper);
    cursor: pointer;
    font: 650 15px var(--sans);
    padding: 16px 20px;
    margin-top: 28px;
  }
  .payment-button:disabled { cursor: not-allowed; opacity: 0.55; }
  .payment-note, .form-status { color: var(--soft); font-size: 14px; margin-top: 12px; }
  .form-status[data-kind='error'] { color: #9e3d2d; }
  .coupon-row { display: flex; align-items: flex-end; gap: 10px; margin-top: 16px; }
  .coupon-label { display: flex; flex-direction: column; gap: 6px; font-family: var(--sans); font-size: 13px; }
  .coupon-label small { color: var(--soft); }
  .coupon-label input { max-width: 200px; text-transform: uppercase; }
  .coupon-apply { padding: 9px 16px; border: 1px solid var(--line); border-radius: 4px; background: var(--chalk); font-family: var(--sans); font-size: 13px; cursor: pointer; }
  .coupon-status { margin-top: 8px; color: var(--soft); font-family: var(--sans); font-size: 13px; }
  .coupon-status[data-kind='ok'] { color: var(--green-ink); }
  .coupon-status[data-kind='error'] { color: #9e3d2d; }
  .turnstile { margin-top: 20px; }
  .registration-summary { position: sticky; top: 118px; }
  .summary-card { border: 1px solid var(--line); background: var(--raised); padding: 28px; }
  .summary-card h2 { font-size: 25px; margin: 6px 0 24px; }
  .summary-card dl { display: grid; gap: 18px; }
  .summary-card dl div { border-bottom: 1px dotted var(--line); padding-bottom: 13px; }
  .summary-card dl div[hidden] { display: none; }
  .summary-card dt { color: var(--soft); font: 11px var(--sans); letter-spacing: 0.12em; text-transform: uppercase; }
  .summary-card dd { margin-top: 4px; line-height: 1.35; }
  .summary-total { display: flex; justify-content: space-between; align-items: baseline; padding-top: 24px; font-family: var(--sans); }
  .summary-total strong { color: var(--green-ink); font-size: 28px; }
  .support-card { display: grid; gap: 3px; padding: 22px 4px; font-size: 15px; }
  .support-card p { color: var(--soft); font-style: italic; margin-bottom: 5px; }
  :global(.success-card) { border-top: 4px solid var(--green); background: var(--raised); padding: 42px; }
  :global(.success-card h2) { font-size: 34px; margin: 8px 0 14px; }
  :global(.success-card p) { color: var(--soft); max-width: 52ch; }
  :global(.success-card a) { display: inline-block; margin-top: 22px; font-family: var(--sans); font-weight: 650; }
  .loading-copy { color: var(--soft); font-style: italic; }
  .error-copy { color: #9e3d2d; }
  .honeypot { display: none; }
  @media (max-width: 820px) {
    .registration-intro, .registration-layout { grid-template-columns: 1fr; }
    .registration-intro { gap: 22px; }
    .registration-layout { gap: 20px; }
    .registration-summary { position: static; grid-row: 1; }
  }
  @media (max-width: 560px) {
    .registration-head { padding: 38px 0 34px; }
    .field-grid { grid-template-columns: 1fr; }
    .field-grid .wide { grid-column: auto; }
    :global(.offer-option) { grid-template-columns: auto 1fr; }
    :global(.offer-price) { grid-column: 2; }
  }

  .sessions-card { margin-top: 1rem; }
  .session-list { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.55rem; }
  .session-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.5rem; font-size: 0.92rem; line-height: 1.35; }
  .session-list strong { font-weight: 600; }
  .session-note { margin: 0.9rem 0 0; font-size: 0.82rem; opacity: 0.75; }
</style>

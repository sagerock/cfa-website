---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
import { FACULTY_TAG } from '../../data/programMeta.js';
import facultyData from '../../data/faculty.json';
import coursesData from '../../data/courses.json';

export async function getStaticPaths() {
  const pages = await getCollection('spine', (e) =>
    ['programs', 'residency'].includes(e.data.section)
  );
  return pages.map((e) => ({ params: { slug: e.data.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const rich = !!d.tagline;

const tag = FACULTY_TAG[d.slug];
const people = tag
  ? facultyData.faculty.filter((p) => p.programs.includes(tag)).sort((a, b) =>
      a.name.split(' ').pop().localeCompare(b.name.split(' ').pop())
    )
  : [];

const isWHS = d.slug === 'waldorf-high-school';
const YEAR_NAME = { 1: 'First Year', 2: 'Second Year', 3: 'Third Year' };
const years = isWHS
  ? [1, 2, 3].map((y) => ({ name: YEAR_NAME[y], courses: coursesData.courses.filter((c) => c.year === y) }))
  : [];

const contactHref = `/contact?program=${encodeURIComponent(d.navLabel)}`;
---

<Base title={`${d.navLabel} — Center for Anthroposophy`} current="/programs">
  {rich ? (
    <>
      <header class="prog-hero">
        <div class="wrap">
          <p class="eyebrow">{d.category ?? 'Program'}</p>
          <h1>{d.navLabel}</h1>
          <p class="prog-tagline">{d.tagline}</p>
          <div class="prog-cta">
            <a class="btn" href={contactHref} data-track={`program-${d.slug}-requestinfo`}>Request information</a>
            {d.applyUrl && <a class="btn btn-ghost" href={d.applyUrl}>{d.applyLabel ?? 'Apply now'}</a>}
            {d.flyerUrl && <a class="prog-flyer" href={d.flyerUrl}>Download the flyer (PDF)</a>}
          </div>
        </div>
      </header>
      {d.heroImage && (
        <div class="wrap"><figure class="prog-heroimg"><img src={d.heroImage} alt="" /></figure></div>
      )}

      <section class="band">
        <div class="wrap prog-grid">
          <div class="prog-main prose"><Content /></div>
          <aside class="prog-side">
            {d.facts && (
              <div class="facts-card">
                <h3>At a glance</h3>
                <dl>
                  {d.facts.map((f) => (<><dt>{f.label}</dt><dd>{f.value}</dd></>))}
                </dl>
              </div>
            )}
            {d.director && (
              <div class="director-card">
                {d.directorPhoto && <img class="director-photo" src={d.directorPhoto} alt={d.director} />}
                <div>
                  <p class="director-name">{d.director}</p>
                  <p class="director-role">{d.directorRole ?? 'Program Director'}</p>
                  {d.directorEmail && <a class="director-mail" href={`mailto:${d.directorEmail}`}>Email with questions</a>}
                </div>
              </div>
            )}
            <a class="btn btn-block" href={contactHref} data-track={`program-${d.slug}-sidebar`}>Request information</a>
          </aside>
        </div>
      </section>

      {d.testimonials && (
        <section class="band testimonials-band">
          <div class="wrap">
            <p class="eyebrow" style="text-align:center">What participants say</p>
            <div class="tcards">
              {d.testimonials.map((t) => (
                <blockquote class="tcard">
                  <p>{t.quote}</p>
                  {t.who && <cite>— {t.who}</cite>}
                </blockquote>
              ))}
            </div>
          </div>
        </section>
      )}

      {people.length > 0 && (
        <section class="band"><div class="wrap">
          <div class="fstrip" style="border-top:0;padding-top:0">
            <p class="eyebrow">Faculty</p>
            <p class="who" style="margin:6px 0 10px">{people.slice(0, 10).map((p) => p.name).join(' · ')}{people.length > 10 ? ` · and ${people.length - 10} more` : ''}</p>
            <a href={`/faculty?program=${tag}`}>See all {people.length} {d.navLabel} faculty →</a>
          </div>
        </div></section>
      )}

      <section class="cta-band"><div class="wrap">
        <h2>Ready to learn more?</h2>
        <p>Questions about whether this program is right for you? We'd love to hear from you.</p>
        <a class="btn btn-lg" href={contactHref} data-track={`program-${d.slug}-footer`}>Request information</a>
      </div></section>
    </>
  ) : (
    <>
      <PageHeader eyebrow={d.section === 'residency' ? 'Attending a Residency' : 'Program'} title={d.navLabel} />
      <article class="article"><div class="wrap">
        <div class="prose"><Content /></div>

        {isWHS && (
          <section class="band" id="catalog">
            <div class="shead"><p class="eyebrow">Course catalog</p><h2>{coursesData.courses.length} courses across three years</h2></div>
            <div class="note">Formerly 73 separate WordPress pages with no inbound links — now one data file, rendered as a browsable catalog.</div>
            <div class="catalog">
              {years.map(({ name, courses }) => (
                <div>
                  <h3 class="yeartag">{name}<span class="ct">{courses.length}</span></h3>
                  {courses.map((c) => (
                    <details class="course"><summary><span class="ccode">{c.code}</span><span class="csub">{c.subject}</span></summary>
                      <div class="cbody"><p>{c.description.replace(/[#*>\[\]]/g, '').slice(0, 900)}</p></div></details>
                  ))}
                </div>
              ))}
            </div>
          </section>
        )}

        {people.length > 0 && (
          <div class="fstrip">
            <p class="eyebrow">Faculty</p>
            <div class="row"><span class="who">{people.slice(0, 8).map((p) => p.name).join(' · ')}{people.length > 8 ? ` · and ${people.length - 8} more` : ''}</span></div>
            <p style="margin-top:10px"><a href={`/faculty?program=${tag}`}>See all {people.length} {d.navLabel} faculty →</a></p>
          </div>
        )}
      </div></article>
    </>
  )}
</Base>

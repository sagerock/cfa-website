---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { PROGRAM_GROUPS, RESIDENCY_GROUP } from '../data/programMeta.js';
import facultyData from '../data/faculty.json';
import coursesData from '../data/courses.json';

const spine = await getCollection('spine');
const bySlug = Object.fromEntries(spine.map((e) => [e.data.slug, e]));
const activeN = facultyData.faculty.filter((p) => p.active).length;
---

<Base title="Center for Anthroposophy — Waldorf teacher education" current="/">
  <header class="hero">
    <div class="wrap">
      <svg class="mark draw" viewBox="0 0 340 120" fill="none" aria-hidden="true">
        <path
          d="M20 60 C20 20 90 20 130 60 C170 100 240 100 250 60 C260 20 190 20 170 60 C150 100 90 100 60 60 C40 32 300 22 320 60 C330 82 300 96 280 92"
          stroke="var(--green)"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
      <p class="eyebrow">Waldorf teacher education since 1981</p>
      <h1>Center for Anthroposophy</h1>
      <p class="lede">Preparing Waldorf teachers through study, artistic work, and self-development.</p>
      <p class="place">Wilton &amp; Keene, New Hampshire</p>
    </div>
  </header>

  <hr class="rule" />

  <section class="band">
    <div class="wrap">
      <div class="shead">
        <p class="eyebrow">Programs</p>
        <h2>Find your path into Waldorf education</h2>
        <p>
          From a first exploration of anthroposophy to full high-school teacher certification —
          {coursesData.courses.length} courses, {activeN} active faculty.
        </p>
      </div>
      <div class="iagrid">
        {PROGRAM_GROUPS.map((g) => (
          <div class="iagroup">
            <h3 class="iatag">{g.name}</h3>
            <ul>
              {g.slugs.map((s) => (
                <li>
                  <a href={`/programs/${s}`}>
                    <span>{bySlug[s]?.data.navLabel ?? s}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div class="iagroup">
          <h3 class="iatag">{RESIDENCY_GROUP.name}</h3>
          <ul>
            {RESIDENCY_GROUP.slugs.map((s) => (
              <li>
                <a href={`/programs/${s}`}><span>{bySlug[s]?.data.navLabel ?? s}</span></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

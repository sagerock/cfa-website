---
import Base from '../layouts/Base.astro';
---

<Base title="Thank you — Center for Anthroposophy" current="/contact">
  <section class="thankyou">
    <div class="wrap">
      <svg class="mark" viewBox="0 0 340 120" fill="none" aria-hidden="true">
        <path
          d="M20 60 C20 20 90 20 130 60 C170 100 240 100 250 60 C260 20 190 20 170 60 C150 100 90 100 60 60 C40 32 300 22 320 60 C330 82 300 96 280 92"
          stroke="var(--green)"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
      <p class="eyebrow">Message received</p>
      <h1>Thank you — we'll be in touch</h1>
      <p>
        Your request has reached the Center for Anthroposophy. Someone will get back to you soon.
        In the meantime, feel free to keep exploring.
      </p>
      <div class="actions">
        <a class="btn" href="/programs">Browse the programs</a>
        <a class="btn btn-ghost" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Base>

---
import { TRACK_ENDPOINT } from '../data/site.js';
---
{/* First-party, privacy-friendly analytics: no cookies, no third parties, no IP stored.
    A random per-visit session id groups a visit. Captures the traffic source (UTM tags if
    present, else the referrer) as FIRST-TOUCH so it can be attached to any lead this visit. */}
<script is:inline define:vars={{ endpoint: TRACK_ENDPOINT }}>
  (function () {
    try {
      var KEY = 'cfa_sid', SRC = 'cfa_src', UTM = 'cfa_utm';
      var sid = sessionStorage.getItem(KEY);
      if (!sid) { sid = Date.now().toString(36) + Math.random().toString(36).slice(2, 10); sessionStorage.setItem(KEY, sid); }

      function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }
      function classify(ref) {
        ref = (ref || '').toLowerCase();
        if (ref.indexOf('google') > -1) return 'Google';
        if (ref.indexOf('facebook') > -1 || ref.indexOf('fb.') > -1) return 'Facebook';
        if (ref.indexOf('instagram') > -1) return 'Instagram';
        if (ref.indexOf('linkedin') > -1 || ref.indexOf('lnkd') > -1) return 'LinkedIn';
        if (ref.indexOf('bing') > -1) return 'Bing';
        if (ref.indexOf('t.co') > -1 || ref.indexOf('twitter') > -1 || ref.indexOf('x.com') > -1) return 'X/Twitter';
        if (!ref) return 'Direct';
        if (ref.indexOf(location.host) > -1) return 'Direct';
        return 'Other';
      }
      // Capture UTM + source ONCE per visit (first touch).
      if (!sessionStorage.getItem(SRC)) {
        var q = new URLSearchParams(location.search);
        var utm = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
          var v = q.get(k); if (v) utm[k] = v.slice(0, 120);
        });
        var src = utm.utm_source ? cap(utm.utm_source) : classify(document.referrer);
        sessionStorage.setItem(SRC, src);
        sessionStorage.setItem(UTM, JSON.stringify(utm));
      }
      var source = sessionStorage.getItem(SRC) || 'Direct';

      function send(event, meta) {
        var payload = JSON.stringify({
          event: event, path: location.pathname, referrer: document.referrer || '',
          session_id: sid, meta: Object.assign({ source: source }, meta || {}),
        });
        try {
          if (navigator.sendBeacon) navigator.sendBeacon(endpoint, new Blob([payload], { type: 'application/json' }));
          else fetch(endpoint, { method: 'POST', headers: { 'content-type': 'application/json' }, body: payload, keepalive: true });
        } catch (e) {}
      }
      send('pageview');
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-track]');
        if (el) send('cta_click', { label: el.getAttribute('data-track') });
      });
      window.__cfaTrack = send;
    } catch (e) {}
  })();
</script>

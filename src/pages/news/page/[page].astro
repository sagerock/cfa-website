---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import NewsGrid from '../../../components/NewsGrid.astro';
import { getCollection } from 'astro:content';
import { indexPosts } from '../../../data/newsHelpers.js';

export async function getStaticPaths({ paginate }) {
  const items = indexPosts(await getCollection('posts'));
  return paginate(items, { pageSize: 24 });
}

const { page } = Astro.props;
const newer = page.currentPage === 2 ? '/news' : `/news/page/${page.currentPage - 1}`;
---

<Base title={`News & Views — page ${page.currentPage} — Center for Anthroposophy`} current="/news">
  <PageHeader eyebrow="News & Views" title="News &amp; Views" />
  <section class="band">
    <div class="wrap">
      <NewsGrid items={page.data} />
      <nav class="pager" aria-label="Pagination">
        {page.currentPage > 1 ? <a href={newer}>← Newer</a> : <span class="disabled">← Newer</span>}
        <span class="pager-count">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next}>Older →</a> : <span class="disabled">Older →</span>}
      </nav>
    </div>
  </section>
</Base>

# Mux's environment key identifies analytics data and is safe for browser-side metrics.
PUBLIC_MUX_ENVIRONMENT_KEY=

# Mux Video API credentials are server-side secrets. Never prefix these with PUBLIC_.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Required later for signed participant-only playback.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Supabase Edge Function secrets for first-party registration. Never expose the
# transaction key in Astro or prefix it with PUBLIC_. Production stays off until
# REGISTRATION_LIVE is explicitly set to true after the controlled live-card test.
AUTHORIZE_NET_ENVIRONMENT=sandbox
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_PUBLIC_CLIENT_KEY=
REGISTRATION_RATE_LIMIT_SALT=
REGISTRATION_LIVE=false
# Controlled production tests only. Keep disabled and the token unset normally;
# the SHA-256 token digest also needs a short-lived payment_test_authorizations row.
REGISTRATION_TEST_MODE=false
REGISTRATION_TEST_TOKEN=
# Optional per-run override of the $1 test charge; the merchant fraud filter holds $1 for
# review, which blocks the payment-plan profile step. 5000 ($50 → $10 first installment)
# is known to be approved. Unset when disarming.
REGISTRATION_TEST_AMOUNT_CENTS=
REGISTRATION_FROM="Center for Anthroposophy <no-reply@centerforanthroposophy.org>"
LEARN_REDIRECT_URL=https://learn.centerforanthroposophy.org/learn/auth?next=/learn/starlight-rays-2026-2027
TURNSTILE_SITE_KEY=0x4AAAAAAESC-IFC5viuXDvL
TURNSTILE_SECRET_KEY=
# Payment-plan scheduling failures (installment 1 charged, ARB schedule not
# created) are emailed here so a person reconciles them. Defaults to the office.
PLAN_ALERT_EMAIL=office@centerforanthroposophy.org

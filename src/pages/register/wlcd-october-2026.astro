---
import Base from '../../layouts/Base.astro';
import {
  FEATURED_BILLING_COUNTRY_CODES,
  ISO_COUNTRY_CODES,
} from '../../../supabase/functions/_shared/billingCountries.js';

const countryNames = new Intl.DisplayNames(['en'], { type: 'region' });
const featuredCountryCodes = new Set(FEATURED_BILLING_COUNTRY_CODES);
const countryOption = (code) => ({ code, name: countryNames.of(code) || code });
const featuredCountries = FEATURED_BILLING_COUNTRY_CODES.map(countryOption);
const otherCountries = ISO_COUNTRY_CODES
  .filter((code) => !featuredCountryCodes.has(code))
  .map(countryOption)
  .sort((a, b) => a.name.localeCompare(b.name, 'en'));
---

<Base title="Register for the October residency in Keene | Center for Anthroposophy" minimal>
  <header class="registration-head">
    <div class="wrap registration-intro">
      <div>
        <a class="eyebrow series-link" href="/programs/waldorf-leadership-development/">Waldorf Leadership &amp; Community Development →</a>
        <h1>October residency</h1>
        <p class="cohort">KEENE, NEW HAMPSHIRE · OCTOBER 9–13, 2026</p>
      </div>
      <p class="intro-copy">
        This year the fall residency is open on its own, without joining the full year. Come for the
        long weekend, work alongside colleagues from other schools, and decide later whether the rest
        of the program is for you. Three or more people from one school register at 20% off.
      </p>
    </div>
  </header>

  <div class="wrap registration-layout">
    <main class="registration-main">
      <div id="sandbox-note" class="sandbox-note" hidden>
        <strong>Sandbox preview</strong>
        No live merchant account will be charged while this page is in sandbox mode.
      </div>
      <div id="production-test-note" class="sandbox-note" hidden>
        <strong>Authorized production test</strong>
        This checkout charges $1 and immediately voids the transaction. No registration is created.
      </div>

      <form id="registration-form" novalidate>
        <!-- Bot trap. Hidden from layout so password managers never fill it; bots parsing HTML still do. -->
        <div class="honeypot" aria-hidden="true">
          <label>Leave this field empty <input type="text" name="fax_confirm" tabindex="-1" autocomplete="off" /></label>
        </div>

        <fieldset class="form-section">
          <legend><span>01</span> Who is coming</legend>
          <div id="offer-list" class="offer-list" aria-live="polite">
            <p class="loading-copy">Loading registration options…</p>
          </div>
          <label id="seats-field" class="seats-field" hidden>
            How many people from your school?
            <input type="number" id="seats-input" name="seats" inputmode="numeric" value="3" min="3" max="12" />
            <small id="seats-help">Three or more, at $680 each.</small>
          </label>
        </fieldset>

        <fieldset class="form-section">
          <legend><span>02</span> <span id="details-legend-text" class="legend-label">Participant details</span></legend>
          <div class="field-grid">
            <label for="participant-first-name">
              First name
              <input type="text" id="participant-first-name" name="first_name" autocomplete="given-name" maxlength="100" required />
            </label>
            <label for="participant-last-name">
              Last name
              <input type="text" id="participant-last-name" name="last_name" autocomplete="family-name" maxlength="100" required />
            </label>
            <label class="wide" for="participant-email">
              Email
              <input type="email" id="participant-email" name="email" autocomplete="email" maxlength="254" required />
              <span id="email-helper">We'll send your confirmation and the residency details here.</span>
            </label>
            <label for="participant-phone">
              Phone <small>optional</small>
              <input type="tel" id="participant-phone" name="phone" autocomplete="tel" maxlength="50" />
            </label>
            <label id="organization-field" hidden>
              School or institution
              <input type="text" name="organization" autocomplete="organization" maxlength="200" />
            </label>
          </div>
          <div id="roster-block" hidden>
            <p class="section-note">Who is attending? You can register colleagues whether or not you are coming yourself.</p>
            <div id="roster-rows" class="roster-rows"></div>
          </div>
        </fieldset>

        <fieldset class="form-section" id="billing-section">
          <legend><span>03</span> Contact and billing address</legend>
          <p class="section-note">We'll keep this with your CfA contact record and use it to process your payment.</p>
          <div class="field-grid">
            <label class="wide" for="billing-address1">
              Street address
              <input type="text" id="billing-address1" name="address1" autocomplete="billing street-address" maxlength="200" required />
            </label>
            <label for="billing-city">
              City
              <input type="text" id="billing-city" name="city" autocomplete="billing address-level2" maxlength="100" required />
            </label>
            <label for="billing-state">
              <span class="field-heading"><span id="billing-state-label">State</span> <small id="billing-state-optional" hidden>optional</small></span>
              <input type="text" id="billing-state" name="state" autocomplete="billing address-level1" maxlength="100" placeholder="e.g. NH" required />
            </label>
            <label for="billing-zip">
              <span class="field-heading"><span id="billing-zip-label">ZIP code</span> <small id="billing-zip-optional" hidden>optional</small></span>
              <input type="text" id="billing-zip" name="zip" autocomplete="billing postal-code" maxlength="30" placeholder="e.g. 03431" required />
            </label>
            <label for="billing-country">
              Country
              <select id="billing-country" name="country" autocomplete="billing country" required>
                {featuredCountries.map((country) => <option value={country.code}>{country.name}</option>)}
                <option disabled>──────────</option>
                {otherCountries.map((country) => <option value={country.code}>{country.name}</option>)}
              </select>
              <span>All prices and card charges are in U.S. dollars (USD).</span>
              <span id="country-discount-note" hidden>Canadian orders receive 20% off automatically.</span>
            </label>
          </div>
        </fieldset>

        <fieldset class="form-section final-section">
          <legend><span>04</span> Confirm and pay</legend>
          <label class="check-row">
            <input type="checkbox" name="terms_accepted" required />
            <span><span id="terms-copy">I authorize the selected charge and understand that registration is subject to CfA's cancellation policies.</span> <a href="/policies/cancellation/" target="_blank" rel="noopener">Read the cancellation policy</a>.</span>
          </label>
          <label class="check-row">
            <input type="checkbox" name="marketing_opt_in" />
            <span>Send me occasional Center for Anthroposophy program news.</span>
          </label>
          <div id="turnstile-widget" class="turnstile"></div>
          <button
            id="payment-button"
            class="payment-button"
            type="button"
            disabled
          >
            Payment setup required
          </button>
          <p class="payment-note">Card details are collected securely by Authorize.Net and never pass through this website.</p>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </fieldset>
      </form>
    </main>

    <aside class="registration-summary" aria-labelledby="summary-title">
      <div class="summary-card">
        <p class="eyebrow">Registration ledger</p>
        <h2 id="summary-title">Your selection</h2>
        <dl>
          <div>
            <dt>Program</dt>
            <dd>WLCD October residency</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>Gathering Waters Charter School, Keene, NH</dd>
          </div>
          <div>
            <dt>Dates</dt>
            <dd>Friday, October 9 – Tuesday, October 13, 2026</dd>
          </div>
          <div>
            <dt>Registration</dt>
            <dd id="summary-offer">Choose an option</dd>
          </div>
          <div id="summary-seats" hidden>
            <dt>People</dt>
            <dd id="summary-seats-copy"></dd>
          </div>
          <div id="summary-discount" hidden>
            <dt>Adjustment</dt>
            <dd id="summary-discount-copy"></dd>
          </div>
        </dl>
        <div class="summary-total">
          <span>Total</span>
          <strong id="summary-price">—</strong>
        </div>
      </div>
      <div class="support-card">
        <p>Questions before registering?</p>
        <a href="mailto:office@centerforanthroposophy.org">office@centerforanthroposophy.org</a>
        <a href="tel:+16036542566">603-654-2566</a>
      </div>
    </aside>
  </div>
</Base>

<script>
  import {
    getBillingAddressRule,
    isSupportedBillingCountry,
  } from '../../../supabase/functions/_shared/billingCountries.js';
  import { seatRange } from '../../../supabase/functions/_shared/seatPricing.js';

  // One checkout serves several programs; this page is the October residency.
  // The server re-derives every amount from the program's own offer rows.
  const PROGRAM_KEY = 'wlcd-october-2026';
  const PROGRAM_LABEL = 'WLCD October residency';
  const base = 'https://ckloewflialohuvixmvd.supabase.co/functions/v1/cfa-register';
  const endpoint = `${base}?program=${PROGRAM_KEY}`;
  const form = document.getElementById('registration-form');

  const offerList = document.getElementById('offer-list');
  const paymentButton = document.getElementById('payment-button');
  const status = document.getElementById('form-status');
  const organizationField = document.getElementById('organization-field');
  const organizationInput = form.elements.namedItem('organization');
  const detailsLegend = document.getElementById('details-legend-text');
  const emailHelper = document.getElementById('email-helper');
  const seatsField = document.getElementById('seats-field');
  const seatsInput = document.getElementById('seats-input');
  const seatsHelp = document.getElementById('seats-help');
  const rosterBlock = document.getElementById('roster-block');
  const rosterRows = document.getElementById('roster-rows');
  const summaryOffer = document.getElementById('summary-offer');
  const summarySeats = document.getElementById('summary-seats');
  const summarySeatsCopy = document.getElementById('summary-seats-copy');
  const summaryPrice = document.getElementById('summary-price');
  const summaryDiscount = document.getElementById('summary-discount');
  const summaryDiscountCopy = document.getElementById('summary-discount-copy');
  const countryDiscountNote = document.getElementById('country-discount-note');
  const billingCountryInput = form.elements.namedItem('country');
  const billingStateInput = form.elements.namedItem('state');
  const billingZipInput = form.elements.namedItem('zip');
  const billingStateLabel = document.getElementById('billing-state-label');
  const billingZipLabel = document.getElementById('billing-zip-label');
  const billingStateOptional = document.getElementById('billing-state-optional');
  const billingZipOptional = document.getElementById('billing-zip-optional');
  const sandboxNote = document.getElementById('sandbox-note');
  const productionTestNote = document.getElementById('production-test-note');
  const fragment = new URLSearchParams(location.hash.slice(1));
  const testToken = fragment.get('test_token') || '';
  if (testToken) history.replaceState(null, '', location.pathname + location.search);
  let config;
  const checkoutKeyName = testToken
    ? `cfa-wlcd-october-checkout-id-${testToken.slice(0, 12)}`
    : 'cfa-wlcd-october-checkout-id';
  let idempotencyKey = localStorage.getItem(checkoutKeyName) || crypto.randomUUID();
  localStorage.setItem(checkoutKeyName, idempotencyKey);
  let turnstileToken = '';
  let turnstileWidgetId;
  const pageParams = new URLSearchParams(location.search);
  const requestedOfferCode = pageParams.get('offer') || '';

  function safeReferrer(value) {
    try {
      const referrer = new URL(value);
      return `${referrer.origin}${referrer.pathname}`.slice(0, 500);
    } catch {
      return '';
    }
  }

  function captureAttribution() {
    const storageKey = 'cfa-registration-attribution';
    try {
      const stored = JSON.parse(sessionStorage.getItem(storageKey) || 'null');
      if (stored && typeof stored === 'object' && !Array.isArray(stored)) return stored;
    } catch {}

    const captured = {
      captured_at: new Date().toISOString(),
      landing_path: location.pathname.slice(0, 500),
      referrer: safeReferrer(document.referrer),
    };
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid', 'msclkid']
      .forEach((key) => {
        const value = (pageParams.get(key) || '').trim();
        if (value) captured[key] = value.slice(0, key.startsWith('utm_') ? 300 : 500);
      });
    try { sessionStorage.setItem(storageKey, JSON.stringify(captured)); } catch {}
    return captured;
  }

  const attribution = captureAttribution();
  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });

  function setStatus(message, kind = '') {
    status.textContent = message;
    status.dataset.kind = kind;
  }

  function selectedOffer() {
    const code = new FormData(form).get('offer_code');
    return config?.offers?.find((offer) => offer.code === code);
  }

  function selectedSeats(offer) {
    if (!offer?.per_seat) return 1;
    const { min, max } = seatRange(offer);
    const asked = Number(seatsInput.value);
    if (!Number.isInteger(asked)) return min;
    return Math.min(max, Math.max(min, asked));
  }

  function selectedAutomaticDiscount() {
    const country = billingCountryInput?.value || '';
    return config?.automatic_discounts?.find((rule) => rule.country_code === country) || null;
  }

  function listAmountCents(offer) {
    if (!offer) return 0;
    return offer.per_seat ? offer.amount_cents * selectedSeats(offer) : offer.amount_cents;
  }

  function effectiveDiscount(offer) {
    const automatic = selectedAutomaticDiscount();
    if (!offer || !automatic) return { amount_cents: 0, source: null };
    const list = listAmountCents(offer);
    return {
      amount_cents: Math.min(list, Math.round(list * automatic.percent_off / 100)),
      source: automatic,
    };
  }

  function effectiveAmountCents(offer) {
    if (!offer) return null;
    return listAmountCents(offer) - effectiveDiscount(offer).amount_cents;
  }

  const billingSection = document.getElementById('billing-section');
  const baseBillingInputs = ['address1', 'city', 'country']
    .map((name) => form.elements.namedItem(name));
  const termsCopy = document.getElementById('terms-copy');

  function updateBillingAddressFields(free) {
    const country = billingCountryInput?.value || '';
    const rule = getBillingAddressRule(country);
    billingStateLabel.textContent = rule.regionLabel;
    billingZipLabel.textContent = rule.postalLabel;
    billingStateInput.placeholder = rule.regionPlaceholder;
    billingZipInput.placeholder = rule.postalPlaceholder;
    baseBillingInputs.forEach((input) => { input.required = !free; });
    billingStateInput.required = !free && rule.regionRequired;
    billingZipInput.required = !free && rule.postalRequired;
    billingStateOptional.hidden = free || rule.regionRequired;
    billingZipOptional.hidden = free || rule.postalRequired;
    billingCountryInput.setCustomValidity(
      free || isSupportedBillingCountry(country) ? '' : 'Choose a valid billing country.',
    );
  }

  // One row per seat. Rebuilt only when the count changes, so typing a name
  // and then adding a person does not wipe what is already entered.
  function renderRosterRows(seats) {
    const existing = rosterRows.querySelectorAll('.roster-row').length;
    if (existing === seats) return;
    if (seats > existing) {
      for (let index = existing; index < seats; index += 1) {
        const row = document.createElement('div');
        row.className = 'roster-row';
        const heading = document.createElement('p');
        heading.className = 'roster-heading';
        heading.textContent = `Participant ${index + 1}`;
        const grid = document.createElement('div');
        grid.className = 'field-grid';
        [
          { key: 'first_name', label: 'First name', type: 'text', max: 100 },
          { key: 'last_name', label: 'Last name', type: 'text', max: 100 },
          { key: 'email', label: 'Email', type: 'email', max: 254, wide: true },
        ].forEach((field) => {
          const label = document.createElement('label');
          if (field.wide) label.className = 'wide';
          label.append(document.createTextNode(field.label));
          const input = document.createElement('input');
          input.type = field.type;
          input.maxLength = field.max;
          input.dataset.rosterField = field.key;
          input.dataset.rosterIndex = String(index);
          label.append(input);
          grid.append(label);
        });
        row.append(heading, grid);
        rosterRows.append(row);
      }
      return;
    }
    Array.from(rosterRows.querySelectorAll('.roster-row'))
      .slice(seats)
      .forEach((row) => row.remove());
  }

  function rosterParticipants() {
    return Array.from(rosterRows.querySelectorAll('.roster-row')).map((row) => ({
      first_name: row.querySelector('[data-roster-field="first_name"]')?.value || '',
      last_name: row.querySelector('[data-roster-field="last_name"]')?.value || '',
      email: row.querySelector('[data-roster-field="email"]')?.value || '',
    }));
  }

  function updateSelection() {
    const offer = selectedOffer();
    const isGroup = Boolean(offer?.per_seat);
    const seats = selectedSeats(offer);
    organizationField.hidden = !isGroup;
    organizationInput.required = isGroup;
    detailsLegend.textContent = isGroup ? 'Who is paying' : 'Participant details';
    emailHelper.textContent = isGroup
      ? "We'll send the confirmation and residency details to this address."
      : "We'll send your confirmation and the residency details here.";
    seatsField.hidden = !isGroup;
    rosterBlock.hidden = !isGroup;
    if (isGroup) {
      const { min, max } = seatRange(offer);
      seatsInput.min = String(min);
      seatsInput.max = String(max);
      if (Number(seatsInput.value) !== seats) seatsInput.value = String(seats);
      seatsHelp.textContent = `${min} or more, at ${money.format(offer.amount_cents / 100)} each. Up to ${max} through this form — for a larger group, call the office.`;
      renderRosterRows(seats);
    }
    summaryOffer.textContent = offer?.name || 'Choose an option';
    summarySeats.hidden = !isGroup;
    summarySeatsCopy.textContent = isGroup ? `${seats} people` : '';
    const total = effectiveAmountCents(offer);
    const discount = effectiveDiscount(offer);
    const automatic = selectedAutomaticDiscount();
    countryDiscountNote.hidden = !automatic;
    if (automatic) {
      countryDiscountNote.textContent = `${automatic.label}: ${automatic.percent_off}% off every order.`;
    }
    summaryDiscount.hidden = !automatic;
    summaryDiscountCopy.textContent = automatic
      ? `${automatic.label} · ${automatic.percent_off}% off (${money.format(discount.amount_cents / 100)})`
      : '';
    const free = offer && total === 0;
    if (config?.payment?.available) paymentButton.classList.toggle('AcceptUI', !free);
    billingSection.hidden = Boolean(free);
    updateBillingAddressFields(free);
    termsCopy.textContent = free
      ? "I understand that registration is subject to CfA's cancellation policies."
      : "I authorize the selected charge and understand that registration is subject to CfA's cancellation policies.";
    summaryPrice.textContent = offer ? money.format(total / 100) : '—';
    paymentButton.textContent = !offer
      ? 'Choose a registration option'
      : free
      ? 'Complete registration'
      : `Continue to secure payment · ${money.format(total / 100)}`;
  }

  function loadScript(src) {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      script.onload = resolve;
      script.onerror = reject;
      document.body.append(script);
    });
  }

  async function submitRegistration(opaqueData) {
    paymentButton.disabled = true;
    setStatus('Authorizing payment and confirming your place…');
    const data = new FormData(form);
    const offer = selectedOffer();
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        idempotency_key: idempotencyKey,
        test_token: testToken,
        offer_code: data.get('offer_code'),
        seats: selectedSeats(offer),
        participants: offer?.per_seat ? rosterParticipants() : [],
        first_name: data.get('first_name'),
        last_name: data.get('last_name'),
        email: data.get('email'),
        phone: data.get('phone'),
        organization: data.get('organization'),
        company: data.get('fax_confirm'),
        billing_address: {
          address: data.get('address1'),
          city: data.get('city'),
          state: data.get('state'),
          zip: data.get('zip'),
          country: data.get('country'),
        },
        terms_accepted: data.get('terms_accepted') === 'on',
        marketing_opt_in: data.get('marketing_opt_in') === 'on',
        attribution,
        turnstile_token: turnstileToken,
        opaque_data: opaqueData || {},
      }),
    });
    const result = await response.json().catch(() => ({}));
    if (response.ok && result.ok) {
      localStorage.removeItem(checkoutKeyName);
      if (!result.test_mode && !result.replayed) {
        const paidOffer = offer;
        const conversion = {
          value: (result.amount_cents ?? 0) / 100,
          currency: 'USD',
          transaction_id: result.registration_id,
          name: paidOffer ? `${PROGRAM_LABEL}: ${paidOffer.name}` : PROGRAM_LABEL,
          id: paidOffer?.code,
        };
        if (window.__cfaConversion) window.__cfaConversion('purchase', conversion);
        if (window.__cfaTrack) {
          window.__cfaTrack('registration', {
            offer: paidOffer?.code,
            value: conversion.value,
            seats: result.seats ?? 1,
          });
        }
      }
      form.hidden = true;
      const success = document.createElement('section');
      success.className = 'success-card';
      success.tabIndex = -1;
      const eyebrow = document.createElement('p');
      eyebrow.className = 'eyebrow';
      eyebrow.textContent = 'Registration complete';
      const heading = document.createElement('h2');
      heading.textContent = result.test_mode
        ? 'Production payment test complete'
        : 'We will see you in Keene';
      const copy = document.createElement('p');
      copy.textContent = result.test_mode && result.voided
        ? 'The $1 production transaction was approved and immediately voided. No registration was created.'
        : result.email_sent
        ? 'Your payment was approved. A confirmation with the dates and location is on its way to your inbox, and Karen Atkinson will write with schedule and lodging details closer to the residency.'
        : 'Your payment was approved and your place is held. If a confirmation email does not arrive, contact the CfA office and we will resend it.';
      success.append(eyebrow, heading, copy);
      document.querySelector('.registration-main').append(success);
      success.focus();
      return;
    }
    if (response.status === 202) {
      setStatus('Do not submit another payment. The payment result needs manual review. Please contact the CfA office and include this registration reference: ' + (result.registration_id || ''), 'error');
      return;
    } else if (result.error === 'registration_pending') {
      setStatus('Do not submit another payment. A registration for this checkout is already being reviewed. Please contact the CfA office and include this registration reference: ' + (result.registration_id || ''), 'error');
      return;
    } else if (result.error === 'already_registered' || result.error === 'already_enrolled') {
      localStorage.removeItem(checkoutKeyName);
      setStatus('This email is already registered for the October residency. Contact the CfA office if you need to change the registration.', 'error');
      return;
    } else if (result.error === 'invalid_seat_count') {
      setStatus('Please choose a number of people within the range shown.', 'error');
    } else if (result.error === 'organization_required') {
      setStatus('Please add the name of the school registering the group.', 'error');
    } else if (result.error === 'verification_failed') {
      setStatus('The verification check expired. Please complete it again, then resubmit.', 'error');
    } else if (result.error === 'idempotency_conflict') {
      idempotencyKey = crypto.randomUUID();
      localStorage.setItem(checkoutKeyName, idempotencyKey);
      setStatus('This browser held a reference to an earlier checkout. It has been reset — please submit again.', 'error');
    } else {
      setStatus(result.message || 'Registration could not be completed. Please review the form or contact the CfA office before trying again.', 'error');
      if (result.error === 'payment_declined') {
        idempotencyKey = crypto.randomUUID();
        localStorage.setItem(checkoutKeyName, idempotencyKey);
      }
    }
    paymentButton.disabled = false;
    if (window.turnstile && turnstileWidgetId !== undefined) {
      turnstileToken = '';
      window.turnstile.reset(turnstileWidgetId);
    }
  }

  window.responseHandler = async (response) => {
    if (response.messages?.resultCode === 'Error') {
      const message = response.messages.message?.map((item) => item.text).join(' ') || 'Card details could not be accepted.';
      setStatus(message, 'error');
      return;
    }
    try {
      await submitRegistration(response.opaqueData);
    } catch {
      setStatus('We could not confirm the registration. Please do not submit another payment; contact the CfA office for help.', 'error');
    }
  };

  paymentButton.addEventListener('click', (event) => {
    if (!form.reportValidity() || !selectedOffer()) {
      event.preventDefault();
      event.stopImmediatePropagation();
      setStatus('Please complete all required fields before continuing.', 'error');
    } else if (config?.turnstile_site_key && !turnstileToken) {
      event.preventDefault();
      event.stopImmediatePropagation();
      setStatus('Please complete the verification before continuing.', 'error');
    } else if (effectiveAmountCents(selectedOffer()) === 0) {
      event.preventDefault();
      event.stopImmediatePropagation();
      submitRegistration(null).catch(() => {
        setStatus('We could not confirm the registration. Please contact the CfA office for help.', 'error');
      });
    } else {
      setStatus('Enter your card details in the secure Authorize.Net window.');
    }
  }, true);

  form.addEventListener('change', updateSelection);
  form.addEventListener('input', (event) => {
    if (event.target === seatsInput) updateSelection();
  });
  form.addEventListener('submit', (event) => event.preventDefault());

  let checkoutStartTracked = false;
  function trackCheckoutStart() {
    if (checkoutStartTracked) return;
    checkoutStartTracked = true;
    const offer = selectedOffer();
    const conversion = {
      value: (effectiveAmountCents(offer) || 0) / 100,
      currency: 'USD',
      name: offer ? `${PROGRAM_LABEL}: ${offer.name}` : PROGRAM_LABEL,
      id: offer?.code,
    };
    if (window.__cfaConversion) window.__cfaConversion('begin_checkout', conversion);
    if (window.__cfaTrack) window.__cfaTrack('checkout_started', { offer: offer?.code, value: conversion.value });
  }
  form.addEventListener('input', trackCheckoutStart, { once: true });

  async function initialize() {
    try {
      const configHeaders = new Headers({ Accept: 'application/json' });
      if (testToken) configHeaders.set('X-Registration-Test', testToken);
      const response = await fetch(endpoint, { headers: configHeaders });
      if (!response.ok) throw new Error('configuration');
      config = await response.json();
      offerList.replaceChildren();
      const requestedOffer = config.offers.find((offer) => offer.code === requestedOfferCode);
      const visibleOffers = requestedOffer ? [requestedOffer] : config.offers;
      if (!visibleOffers.length) throw new Error('offers');
      visibleOffers.forEach((offer, index) => {
        const label = document.createElement('label');
        label.className = 'offer-option';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'offer_code';
        input.value = offer.code;
        input.checked = index === 0;
        input.required = true;
        const copy = document.createElement('span');
        copy.className = 'offer-copy';
        const name = document.createElement('strong');
        name.textContent = offer.name;
        const description = document.createElement('small');
        description.textContent = offer.description;
        copy.append(name, description);
        const price = document.createElement('span');
        price.className = 'offer-price';
        price.textContent = offer.per_seat
          ? `${money.format(offer.amount_cents / 100)} each`
          : money.format(offer.amount_cents / 100);
        label.append(input, copy, price);
        offerList.append(label);
      });
      updateSelection();
      if (!config.payment.available) {
        setStatus('The registration form is ready for review, but payment credentials are not fully configured.', 'error');
        return;
      }
      sandboxNote.hidden = config.payment.environment !== 'sandbox';
      productionTestNote.hidden = !config.payment.test_mode;
      paymentButton.classList.add('AcceptUI');
      paymentButton.setAttribute('data-billingAddressOptions', JSON.stringify({ show: false, required: false }));
      paymentButton.setAttribute('data-apiLoginID', config.payment.api_login_id);
      paymentButton.setAttribute('data-clientKey', config.payment.public_client_key);
      paymentButton.setAttribute('data-acceptUIFormBtnTxt', 'Authorize payment');
      paymentButton.setAttribute('data-acceptUIFormHeaderTxt', 'Secure card information');
      paymentButton.setAttribute('data-paymentOptions', JSON.stringify({ showCreditCard: true, showBankAccount: false }));
      paymentButton.setAttribute('data-responseHandler', 'responseHandler');
      if (config.turnstile_site_key) {
        await loadScript('https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit');
        turnstileWidgetId = window.turnstile.render('#turnstile-widget', {
          sitekey: config.turnstile_site_key,
          action: 'registration',
          callback: (token) => { turnstileToken = token; },
          'expired-callback': () => { turnstileToken = ''; },
        });
      }
      await loadScript(config.payment.accept_script);
      paymentButton.disabled = false;
      updateSelection();
    } catch {
      offerList.innerHTML = '<p class="loading-copy error-copy">Registration options are temporarily unavailable. Please contact the CfA office.</p>';
      setStatus('Secure payment could not be initialized.', 'error');
    }
  }

  initialize();
</script>


---
import '../styles/global.css';
import { FN } from '../data/site.js';
const STATS_ENDPOINT = `${FN}/cfa-stats`;
const REGISTRATIONS_ENDPOINT = `${FN}/cfa-registrations`;
const INSTITUTION_ROSTER_ENDPOINT = `${FN}/cfa-institution-roster`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Website Dashboard — Center for Anthroposophy</title>
  </head>
  <body class="dash">
    <header class="dash-head">
      <div class="wrap">
        <div>
          <p class="eyebrow">Center for Anthroposophy</p>
          <h1>Website dashboard</h1>
        </div>
        <div class="dash-meta">
          <span id="updated"></span>
          <button id="refresh" type="button">Refresh</button>
        </div>
      </div>
    </header>

    <main class="wrap dash-main">
      <div id="gate" class="gate" hidden>
        <h2>Access token required</h2>
        <p>Open this page with your access token in the address, e.g.<br />
          <code>/dashboard#your-token</code></p>
      </div>

      <div id="error" class="dash-error" hidden></div>

      <div id="content" hidden>
        <section class="tiles" aria-label="Summary">
          <div class="tile"><span class="t-label">Page views</span><span class="t-num" id="m-pageviews">–</span><span class="t-sub">last 90 days</span></div>
          <div class="tile"><span class="t-label">Visits</span><span class="t-num" id="m-sessions">–</span><span class="t-sub">unique sessions</span></div>
          <div class="tile"><span class="t-label">CTA clicks</span><span class="t-num" id="m-cta">–</span><span class="t-sub">Request Info &amp; more</span></div>
          <div class="tile tile-accent"><span class="t-label">Leads captured</span><span class="t-num" id="m-leads">–</span><span class="t-sub" id="m-convrate">contacts from the site</span></div>
        </section>

        <section class="panel">
          <div class="panel-head"><h2>Page views — last 30 days</h2><span class="hint" id="chart-total"></span></div>
          <figure class="chart-wrap"><div id="chart" class="chart" role="img" aria-label="Daily page views, last 30 days"></div></figure>
          <div id="chart-empty" class="empty" hidden>No traffic recorded yet. Visit the site to generate data.</div>
        </section>

        <div class="two-col">
          <section class="panel">
            <div class="panel-head"><h2>Where visitors come from</h2></div>
            <ul class="ranklist" id="sources"></ul>
            <div id="sources-empty" class="empty" hidden>No traffic yet.</div>
          </section>
          <section class="panel">
            <div class="panel-head"><h2>Top pages</h2></div>
            <ul class="ranklist" id="top-pages"></ul>
            <div id="pages-empty" class="empty" hidden>No page views yet.</div>
          </section>
        </div>

        <section class="panel">
          <div class="panel-head"><h2>Recent leads</h2></div>
          <ul class="leadlist" id="recent-leads"></ul>
          <div id="leads-empty" class="empty" hidden>No leads yet. Submissions from the contact form appear here.</div>
        </section>

        <section class="tiles" aria-label="Registrations summary" id="reg-tiles" hidden>
          <div class="tile"><span class="t-label">Active enrollments</span><span class="t-num" id="r-enrolled">–</span><span class="t-sub" id="r-sources">Starlight Rays</span></div>
          <div class="tile"><span class="t-label">Paid registrations</span><span class="t-num" id="r-paid">–</span><span class="t-sub">via the site form</span></div>
          <div class="tile"><span class="t-label">Comped</span><span class="t-num" id="r-comped">–</span><span class="t-sub">coupon registrations</span></div>
          <div class="tile tile-accent"><span class="t-label">Net revenue</span><span class="t-num" id="r-revenue">–</span><span class="t-sub" id="r-pending">collected on the site</span></div>
        </section>

        <section class="panel" id="reg-panel" hidden>
          <div class="panel-head"><h2>Registrations</h2><span class="hint" id="reg-course"></span></div>
          <div class="reg-table-wrap">
            <table class="reg-table">
              <thead>
                <tr><th>Date</th><th>Name</th><th>Email</th><th>Registration</th><th>Coupon</th><th>Amount</th><th>Status</th></tr>
              </thead>
              <tbody id="reg-rows"></tbody>
            </table>
          </div>
          <div id="reg-empty" class="empty" hidden>No registrations through the site form yet. Imported Thinkific enrollments appear in the enrollment count above.</div>
        </section>

        <section class="panel" id="institution-panel" hidden>
          <div class="panel-head">
            <h2>Institution rosters</h2>
            <span class="hint">private links, participant access, and invitation delivery</span>
          </div>
          <div id="institution-rosters" class="institution-rosters"></div>
          <div id="institution-empty" class="empty" hidden>No institutional purchases yet.</div>
        </section>

        <section class="panel" id="programs-panel" hidden>
          <div class="panel-head"><h2>Programs &amp; rosters</h2><span class="hint">click a program to see who's enrolled</span></div>
          <ul class="programlist" id="program-list"></ul>
        </section>
      </div>
    </main>

    <div id="tooltip" class="tooltip" hidden></div>

    <script is:inline define:vars={{
      endpoint: STATS_ENDPOINT,
      regEndpoint: REGISTRATIONS_ENDPOINT,
      institutionEndpoint: INSTITUTION_ROSTER_ENDPOINT,
    }}>
      const $ = (id) => document.getElementById(id);
      const token = decodeURIComponent(location.hash.replace(/^#/, '').trim());
      const fmt = (n) => (n ?? 0).toLocaleString('en-US');

      function showError(msg) { const e = $('error'); e.textContent = msg; e.hidden = false; }

      async function load() {
        if (!token) { $('gate').hidden = false; return; }
        try {
          const res = await fetch(`${endpoint}?token=${encodeURIComponent(token)}`, { cache: 'no-store' });
          if (res.status === 401) { $('gate').hidden = false; return; }
          if (!res.ok) throw new Error('Request failed');
          render(await res.json());
          loadRegistrations();
        } catch (e) {
          showError('Could not load the dashboard. Check your token and try again.');
        }
      }

      function render(d) {
        $('content').hidden = false;
        $('error').hidden = true;
        $('gate').hidden = true;
        const t = d.totals || {};
        $('m-pageviews').textContent = fmt(t.pageviews);
        $('m-sessions').textContent = fmt(t.sessions);
        $('m-cta').textContent = fmt(t.cta_clicks);
        $('m-leads').textContent = fmt(t.leads);
        const rate = t.sessions ? Math.round((t.leads / t.sessions) * 1000) / 10 : 0;
        $('m-convrate').textContent = t.sessions ? `${rate}% of visits became a lead` : 'contacts from the site';
        if (d.generated_at) $('updated').textContent = 'Updated ' + new Date(d.generated_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

        renderChart(d.daily || []);
        renderSources(d.sources || []);
        renderTopPages(d.top_pages || []);
        renderLeads(d.recent_leads || []);
      }

      function renderPrograms(programs) {
        if (!programs.length) return;
        $('programs-panel').hidden = false;
        const list = $('program-list');
        list.replaceChildren();
        programs.forEach((program) => {
          const item = document.createElement('li');
          const row = document.createElement('button');
          row.type = 'button';
          row.className = 'program-row';
          const name = document.createElement('span');
          name.textContent = program.name;
          const count = document.createElement('span');
          count.className = 'program-count';
          count.textContent = `${program.active}`;
          row.append(name, count);
          const roster = document.createElement('div');
          roster.className = 'program-roster';
          roster.hidden = true;
          row.addEventListener('click', async () => {
            if (!roster.hidden) { roster.hidden = true; return; }
            roster.hidden = false;
            if (roster.dataset.loaded) return;
            roster.textContent = 'Loading roster…';
            try {
              const res = await fetch(`${regEndpoint}?token=${encodeURIComponent(token)}&roster=${program.id}`, { cache: 'no-store' });
              if (!res.ok) throw new Error('roster');
              const { people } = await res.json();
              roster.dataset.loaded = '1';
              roster.replaceChildren();
              const table = document.createElement('table');
              table.className = 'reg-table';
              people.forEach((person) => {
                const tr = document.createElement('tr');
                [person.name, person.email, person.organization || '', person.source].forEach((value) => {
                  const td = document.createElement('td');
                  td.textContent = value;
                  tr.append(td);
                });
                table.append(tr);
              });
              roster.append(table);
            } catch {
              roster.textContent = 'Could not load this roster.';
            }
          });
          item.append(row, roster);
          list.append(item);
        });
      }

      async function loadRegistrations() {
        if (!token) return;
        try {
          const res = await fetch(`${regEndpoint}?token=${encodeURIComponent(token)}`, { cache: 'no-store' });
          if (!res.ok) return;
          renderRegistrations(await res.json());
        } catch { /* the analytics half of the dashboard still works */ }
      }

      function renderRegistrations(d) {
        const money = (cents) => (cents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        $('reg-tiles').hidden = false;
        $('reg-panel').hidden = false;
        const t = d.totals || {};
        $('r-enrolled').textContent = fmt(t.active_enrollments);
        $('r-paid').textContent = fmt(t.paid_registrations);
        $('r-comped').textContent = fmt(t.comped_registrations);
        $('r-revenue').textContent = money(t.net_revenue_cents || 0);
        $('r-pending').textContent = t.pending_review
          ? `${t.pending_review} awaiting manual review`
          : 'collected on the site';
        const sources = Object.entries(d.enrollment_sources || {})
          .map(([source, count]) => `${count} ${source}`).join(' · ');
        if (sources) $('r-sources').textContent = sources;
        $('reg-course').textContent = d.course || '';

        renderPrograms(d.programs || []);
        renderInstitutionRosters(d.institution_rosters || []);

        const rows = d.registrations || [];
        if (!rows.length) { $('reg-empty').hidden = false; return; }
        const body = $('reg-rows');
        body.replaceChildren();
        rows.forEach((r) => {
          const tr = document.createElement('tr');
          const cells = [
            new Date(r.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
            r.name,
            r.email,
            r.organization ? `${r.offer} — ${r.organization}` : r.offer,
            r.coupon_code || '—',
            money(r.amount_cents),
            r.status,
          ];
          cells.forEach((value, index) => {
            const td = document.createElement('td');
            td.textContent = value;
            if (index === 6) td.dataset.status = r.status;
            tr.append(td);
          });
          body.append(tr);
        });
      }

      async function institutionAction(action, payload, button) {
        const original = button.textContent;
        button.disabled = true;
        button.textContent = action === 'resend_roster_link' ? 'Sending…' : 'Retrying…';
        try {
          const response = await fetch(institutionEndpoint, {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ action, ...payload }),
          });
          if (!response.ok) throw new Error('action_failed');
          await loadRegistrations();
        } catch {
          button.textContent = 'Try again';
          button.disabled = false;
          return;
        }
        button.textContent = original;
        button.disabled = false;
      }

      function renderInstitutionRosters(rosters) {
        $('institution-panel').hidden = false;
        $('institution-empty').hidden = rosters.length > 0;
        const container = $('institution-rosters');
        container.replaceChildren();
        rosters.forEach((roster) => {
          const card = document.createElement('article');
          card.className = 'institution-card';
          const head = document.createElement('div');
          head.className = 'institution-head';
          const titleWrap = document.createElement('div');
          const title = document.createElement('h3');
          title.textContent = roster.organization;
          const purchaser = document.createElement('p');
          purchaser.textContent = roster.purchaser
            ? `${roster.purchaser.name} · ${roster.purchaser.email}`
            : 'Purchaser record unavailable';
          titleWrap.append(title, purchaser);
          const badge = document.createElement('span');
          badge.className = `roster-badge roster-${roster.status}`;
          badge.textContent = roster.status.replace('_', ' ');
          head.append(titleWrap, badge);

          const facts = document.createElement('dl');
          facts.className = 'institution-facts';
          [
            ['Participants', `${roster.counts.invited} invited · ${roster.counts.total}/${roster.seat_limit} entered`],
            ['Roster link', roster.confirmation_sent ? 'Sent' : 'Not delivered'],
            ['Last opened', roster.last_opened_at ? new Date(roster.last_opened_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : 'Not opened'],
            ['Submitted', roster.submitted_at ? new Date(roster.submitted_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : 'Waiting'],
          ].forEach(([label, value]) => {
            const group = document.createElement('div');
            const dt = document.createElement('dt'); dt.textContent = label;
            const dd = document.createElement('dd'); dd.textContent = value;
            group.append(dt, dd); facts.append(group);
          });

          const actions = document.createElement('div');
          actions.className = 'institution-actions';
          const resend = document.createElement('button');
          resend.type = 'button';
          resend.textContent = roster.confirmation_sent ? 'Send a fresh roster link' : 'Send roster link';
          resend.addEventListener('click', () => institutionAction('resend_roster_link', { roster_id: roster.id }, resend));
          actions.append(resend);

          if (roster.failed_members.length) {
            const failures = document.createElement('div');
            failures.className = 'roster-failures';
            const failureTitle = document.createElement('strong');
            failureTitle.textContent = 'Invitations needing attention';
            failures.append(failureTitle);
            roster.failed_members.forEach((member) => {
              const row = document.createElement('div');
              const person = document.createElement('span');
              person.textContent = `${member.name} · ${member.email}`;
              const retry = document.createElement('button');
              retry.type = 'button';
              retry.textContent = 'Retry access and email';
              retry.addEventListener('click', () => institutionAction('retry_member', { member_id: member.id }, retry));
              row.append(person, retry);
              failures.append(row);
            });
            card.append(head, facts, actions, failures);
          } else {
            card.append(head, facts, actions);
          }
          container.append(card);
        });
      }

      function renderSources(sources) {
        if (!sources.length) { $('sources-empty').hidden = false; return; }
        const max = Math.max(...sources.map((s) => s.visits));
        const list = $('sources');
        list.replaceChildren();
        sources.forEach((source) => {
          const item = document.createElement('li');
          const label = document.createElement('span');
          label.className = 'rl-label';
          label.textContent = source.source;
          const bar = document.createElement('span');
          bar.className = 'rl-bar';
          const fill = document.createElement('span');
          fill.style.width = `${(source.visits / max) * 100}%`;
          bar.append(fill);
          const number = document.createElement('span');
          number.className = 'rl-num';
          number.textContent = fmt(source.visits);
          item.append(label, bar, number);
          list.append(item);
        });
      }

      function renderChart(daily) {
        const total = daily.reduce((s, x) => s + (x.pageviews || 0), 0);
        $('chart-total').textContent = total ? `${fmt(total)} views` : '';
        if (!total) { $('chart').innerHTML = ''; $('chart-empty').hidden = false; return; }
        $('chart-empty').hidden = true;
        const max = Math.max(1, ...daily.map((x) => x.pageviews || 0));
        const W = 100, H = 34, n = daily.length, gap = 0.6;
        const bw = (W - gap * (n - 1)) / n;
        let bars = '';
        daily.forEach((x, i) => {
          const v = x.pageviews || 0;
          const h = v > 0 ? Math.max(0.8, (v / max) * (H - 4)) : 0;
          const xx = i * (bw + gap);
          bars += `<rect x="${xx.toFixed(2)}" y="${(H - h).toFixed(2)}" width="${bw.toFixed(2)}" height="${h.toFixed(2)}" rx="0.5" class="bar" data-day="${x.day}" data-v="${v}"></rect>`;
        });
        $('chart').innerHTML =
          `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" class="chart-svg">
             <line x1="0" y1="${H}" x2="${W}" y2="${H}" class="axis"></line>${bars}
           </svg>
           <div class="chart-axis"><span>${daily[0].day.slice(5)}</span><span>peak ${max}/day</span><span>${daily[n - 1].day.slice(5)}</span></div>`;
        wireBarHover();
      }

      function wireBarHover() {
        const tip = $('tooltip');
        $('chart').querySelectorAll('.bar').forEach((b) => {
           b.addEventListener('mouseenter', (e) => {
             const r = b.getBoundingClientRect();
             const count = document.createElement('b');
             count.textContent = b.dataset.v;
             const label = document.createTextNode(` view${b.dataset.v == 1 ? '' : 's'}`);
             const br = document.createElement('br');
             const date = document.createTextNode(new Date(b.dataset.day + 'T00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
             tip.replaceChildren(count, label, br, date);
            tip.hidden = false;
            tip.style.left = r.left + r.width / 2 + 'px';
            tip.style.top = r.top - 8 + 'px';
          });
          b.addEventListener('mouseleave', () => { tip.hidden = true; });
        });
      }

      function renderTopPages(pages) {
        if (!pages.length) { $('pages-empty').hidden = false; return; }
        const max = Math.max(...pages.map((p) => p.views));
        const list = $('top-pages');
        list.replaceChildren();
        pages.forEach((page) => {
          const item = document.createElement('li');
          const label = document.createElement('span');
          label.className = 'rl-label';
          label.title = page.path;
          label.textContent = page.path;
          const bar = document.createElement('span');
          bar.className = 'rl-bar';
          const fill = document.createElement('span');
          fill.style.width = `${(page.views / max) * 100}%`;
          bar.append(fill);
          const number = document.createElement('span');
          number.className = 'rl-num';
          number.textContent = fmt(page.views);
          item.append(label, bar, number);
          list.append(item);
        });
      }

      function renderLeads(leads) {
        if (!leads.length) { $('leads-empty').hidden = false; return; }
        const list = $('recent-leads');
        list.replaceChildren();
        leads.forEach((lead) => {
          const item = document.createElement('li');
          const name = document.createElement('span');
          name.className = 'ld-name';
          name.textContent = lead.name || '(no name)';
          const program = document.createElement('span');
          program.className = 'ld-prog';
          program.textContent = lead.program || 'General inquiry';
          const meta = document.createElement('span');
          meta.className = 'ld-meta';
          meta.textContent = `${lead.email} · ${new Date(lead.at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}${lead.source ? ` · via ${lead.source}` : ''}`;
          item.append(name, program, meta);
          list.append(item);
        });
      }

      $('refresh').addEventListener('click', load);
      load();
    </script>

    {/* Global: most of this page's DOM is built by its script at runtime, and
        Astro's scoping attribute never lands on JS-created elements. */}
    <style is:global>
      body.dash { background: var(--paper); }
      .dash-head { border-bottom: 1px solid var(--line); background: var(--raised); padding: 18px 0; }
      .dash-head .wrap { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
      .dash-head h1 { font-size: 26px; margin-top: 2px; }
      .dash-meta { display: flex; align-items: center; gap: 14px; font-family: var(--sans); font-size: 13px; color: var(--soft); }
      #refresh { font: inherit; color: var(--green-ink); background: none; border: 1px solid var(--line); border-radius: 20px; padding: 5px 14px; cursor: pointer; }
      #refresh:hover { border-color: var(--green); }
      .dash-main { padding: 28px 24px 60px; }
      .gate, .dash-error { font-family: var(--sans); background: var(--raised); border: 1px solid var(--line); border-radius: 6px; padding: 24px; }
      .gate h2 { font-size: 18px; margin-bottom: 8px; } .gate code { background: var(--paper); padding: 2px 6px; border-radius: 3px; }
      .dash-error { color: #a8324a; border-color: rgba(168,50,74,.3); }

      .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
      @media (max-width: 720px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
      .tile { background: var(--raised); border: 1px solid var(--line); border-radius: 6px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
      .tile-accent { border-color: var(--green); box-shadow: inset 0 0 0 1px var(--green); }
      .t-label { font-family: var(--sans); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--soft); }
      .t-num { font-family: var(--sans); font-size: 34px; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; line-height: 1.1; }
      .tile-accent .t-num { color: var(--green-ink); }
      .t-sub { font-family: var(--sans); font-size: 12px; color: var(--soft); }

      .panel { background: var(--raised); border: 1px solid var(--line); border-radius: 6px; padding: 18px 20px; margin-bottom: 18px; }
      .panel-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
      .panel-head h2 { font-family: var(--sans); font-size: 13px; text-transform: uppercase; letter-spacing: .07em; color: var(--ink); }
      .hint { font-family: var(--sans); font-size: 12.5px; color: var(--soft); font-variant-numeric: tabular-nums; }
      .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
      @media (max-width: 720px) { .two-col { grid-template-columns: 1fr; } }

      .chart-wrap { margin: 0; }
      .chart-svg { width: 100%; height: 150px; display: block; }
      .chart-svg .bar { fill: var(--green); transition: fill .12s; }
      .chart-svg .bar:hover { fill: var(--gold); }
      .chart-svg .axis { stroke: var(--line); stroke-width: .3; }
      .chart-axis { display: flex; justify-content: space-between; font-family: var(--sans); font-size: 11.5px; color: var(--soft); margin-top: 6px; font-variant-numeric: tabular-nums; }
      .empty { font-family: var(--sans); font-size: 13.5px; color: var(--soft); padding: 20px 0; text-align: center; }
      .institution-rosters { display: grid; gap: 12px; }
      .institution-card { border: 1px solid var(--line); border-radius: 5px; padding: 16px; }
      .institution-head { display: flex; justify-content: space-between; gap: 16px; align-items: start; }
      .institution-head h3 { font: 600 17px var(--sans); }
      .institution-head p { color: var(--soft); font: 12.5px var(--sans); margin-top: 3px; }
      .roster-badge { border-radius: 20px; color: var(--soft); background: var(--paper); font: 11px var(--sans); padding: 5px 10px; text-transform: capitalize; }
      .roster-complete { color: var(--green-ink); }
      .roster-needs_attention { color: #a8324a; }
      .institution-facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 15px; }
      .institution-facts div { border-top: 1px solid var(--line); padding-top: 9px; }
      .institution-facts dt { color: var(--soft); font: 10px var(--sans); letter-spacing: .07em; text-transform: uppercase; }
      .institution-facts dd { font: 13px var(--sans); margin-top: 3px; }
      .institution-actions { margin-top: 14px; }
      .institution-actions button, .roster-failures button { border: 1px solid var(--line); border-radius: 3px; color: var(--green-ink); background: var(--raised); cursor: pointer; font: 12px var(--sans); padding: 7px 11px; }
      .institution-actions button:disabled, .roster-failures button:disabled { cursor: wait; opacity: .55; }
      .roster-failures { border-top: 1px solid var(--line); display: grid; gap: 7px; margin-top: 14px; padding-top: 12px; font: 12px var(--sans); }
      .roster-failures > div { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
      @media (max-width: 760px) { .institution-facts { grid-template-columns: repeat(2, 1fr); } }
      .reg-table-wrap { overflow-x: auto; }
      .reg-table { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 13px; }
      .reg-table th { padding: 8px 10px; border-bottom: 2px solid var(--line); color: var(--soft); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; text-align: left; }
      .reg-table td { padding: 9px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
      .reg-table td[data-status='paid'] { color: var(--green-ink); font-weight: 600; }
      .reg-table td[data-status='enrollment_pending'] { color: #a8631e; font-weight: 600; }
      .reg-table td[data-status='refunded'], .reg-table td[data-status='cancelled'] { color: var(--soft); }
      .programlist { list-style: none; margin: 0; padding: 0; }
      .programlist li { border-bottom: 1px solid var(--line); }
      .program-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; width: 100%; padding: 11px 4px; border: 0; background: none; font: 14px var(--sans); color: var(--ink); text-align: left; cursor: pointer; }
      .program-row:hover { color: var(--green-ink); }
      .program-count { flex-shrink: 0; min-width: 34px; padding: 2px 9px; border-radius: 20px; background: var(--chalk); color: var(--green-ink); font-weight: 600; text-align: center; }
      .program-roster { padding: 2px 4px 14px; overflow-x: auto; }

      .ranklist, .leadlist { list-style: none; display: flex; flex-direction: column; gap: 9px; }
      .ranklist li { display: grid; grid-template-columns: 1fr 70px auto; align-items: center; gap: 10px; font-family: var(--sans); font-size: 13px; }
      .rl-label { color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rl-bar { height: 6px; background: var(--chalk); border-radius: 4px; overflow: hidden; }
      .rl-bar span { display: block; height: 100%; background: var(--green); }
      .rl-num { color: var(--soft); font-variant-numeric: tabular-nums; text-align: right; }
      .leadlist li { display: flex; flex-direction: column; gap: 2px; padding-bottom: 9px; border-bottom: 1px dotted var(--line); }
      .ld-name { font-family: var(--sans); font-size: 14px; font-weight: 600; color: var(--ink); }
      .ld-prog { font-family: var(--sans); font-size: 12.5px; color: var(--green-ink); }
      .ld-meta { font-family: var(--sans); font-size: 12px; color: var(--soft); }

      .tooltip { position: fixed; transform: translate(-50%, -100%); background: var(--ink); color: var(--paper); font-family: var(--sans); font-size: 12px; line-height: 1.35; padding: 6px 9px; border-radius: 4px; pointer-events: none; z-index: 50; text-align: center; white-space: nowrap; }
    </style>
  </body>
</html>

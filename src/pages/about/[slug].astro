---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('spine', (e) => e.data.section === 'about');
  return pages.map((e) => ({ params: { slug: e.data.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.navLabel} — Center for Anthroposophy`} current="/about">
  <article class="article">
    <div class="wrap">
      <header>
        <p class="eyebrow">About</p>
        <h1>{entry.data.navLabel}</h1>
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

---
// Kairos Institute public courses: the registration index. Replaces the
// WordPress Kairos general registration form (Gravity Form 137, page 44633,
// /kairos-general-public-oen-course-registration/), which sold every public
// course on one form. Each course now has its own page and checkout here; the
// WordPress form page and its "Register now" buttons point to this page
// (2026-10-16, Sage: "let's migrate them all").
//
// List only courses still open for registration. Remove a card when its
// registration closes. Noindex, the site default.
import Base from '../../layouts/Base.astro';

const courses = [
  {
    href: '/kairos/dyson-mental-health/',
    eyebrow: 'Four online seminars · in progress',
    title: 'The Organic and Psychospiritual Basis of Mental Health',
    who: 'with Dr. James Dyson',
    when: 'Saturdays, September 26 – November 7, 2026 · 3:00 – 5:00 PM Eastern',
    price: '$350 for the series',
  },
  {
    href: '/kairos/emergency-pedagogy-module-7/',
    eyebrow: 'Emergency Pedagogy · online module',
    title: 'Module 7: Disaster, Healing Communities, and Animals',
    who: 'with Bernd Ruf',
    when: 'Friday and Saturday, January 15 – 16, 2027',
    price: '$350 · optional EPWB certificate $45',
  },
  {
    href: '/kairos/gloeckler-bridge-lectures/',
    eyebrow: 'The Bridge Lectures · three Sunday seminars',
    title: 'Enthusiasm as Warmth to Counter the Cold of our Times',
    who: 'with Dr. Michaela Glöckler',
    when: 'January 24, February 14 and February 21, 2027',
    price: '$350 for all six sessions',
  },
];
---

<Base
  title="Register: Kairos Institute public courses | Center for Anthroposophy"
  portalLabel={null}
  minimal
>
  <header class="registration-head">
    <div class="wrap">
      <p class="eyebrow series-link">Kairos Institute · Open to the public</p>
      <h1>Register for a Kairos course</h1>
      <p class="intro-copy">Each course has its own registration page. Choose the one you want to attend.
        Questions about any of them can go to Lisl Hofer at
        <a href="mailto:lisl@centerforanthroposophy.org">lisl@centerforanthroposophy.org</a>.</p>
    </div>
  </header>

  <section class="wrap course-grid" aria-label="Open courses">
    {courses.map((course) => (
      <a class="course-card" href={course.href}>
        <p class="eyebrow">{course.eyebrow}</p>
        <h2>{course.title}</h2>
        <p class="cohort">{course.who}</p>
        <p class="course-details">{course.when}</p>
        <p class="course-format">{course.price}</p>
        <span class="course-link">Register <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </section>
</Base>

<style>
  .registration-head {
    border-bottom: 1px solid var(--line);
    background: linear-gradient(120deg, rgba(176, 136, 16, 0.12), transparent 62%);
    padding: 56px 0 48px;
  }
  .registration-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 48px;
    align-items: center;
  }
  .registration-head h1 {
    font-size: clamp(36px, 4.6vw, 58px);
    letter-spacing: -0.035em;
    margin-top: 6px;
  }
  .series-link { color: var(--green-ink); }
  .cohort {
    color: var(--gold);
    font-family: var(--sans);
    font-size: 18px;
    letter-spacing: 0.035em;
    margin-top: 14px;
  }
  .intro-copy { color: var(--soft); font-size: 20px; max-width: 52ch; margin-top: 24px; }
  .course-details { font: 600 16px/1.7 var(--sans); margin-top: 24px; }
  .course-format { color: var(--soft); font: 14px/1.7 var(--sans); margin-top: 8px; }
  .course-link { display: inline-flex; gap: 16px; margin-top: 24px; color: var(--green-ink); font: 600 15px var(--sans); text-underline-offset: 5px; }
  .course-link:focus-visible { outline: 2px solid var(--green); outline-offset: 6px; }
  .when-card { border: 1px solid var(--line); border-left: 3px solid var(--gold); background: var(--raised); padding: 26px 28px; min-width: 0; }
  .seminar-list { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 18px; }
  .seminar-list li { display: grid; gap: 2px; }
  .seminar-no { color: var(--gold); font: 11px var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .seminar-list strong { font-size: 19px; font-weight: 600; }
  .seminar-parts { color: var(--soft); font: 14px/1.7 var(--sans); }
  .when-note { color: var(--soft); font: 13px/1.6 var(--sans); margin-top: 16px; }
  .facilitator-welcome { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 36px; align-items: start; padding-top: 48px; padding-bottom: 48px; border-bottom: 1px solid var(--line); }
  .facilitator-photo { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; }
  .facilitator-welcome h2 { font-size: clamp(25px, 3vw, 34px); margin: 8px 0 16px; }
  .facilitator-welcome p { max-width: 68ch; margin-top: 12px; }
  .welcome-credit { color: var(--soft); font: 14px/1.6 var(--sans); margin-top: 20px; }

  @media (max-width: 820px) {
    .registration-intro { grid-template-columns: 1fr; gap: 22px; }
  }
  @media (max-width: 560px) {
    .registration-head { padding: 38px 0 34px; }
    .facilitator-welcome { grid-template-columns: 1fr; gap: 22px; padding-top: 32px; padding-bottom: 32px; }
    .facilitator-photo { width: 110px; height: 110px; }
  }
  .course-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; padding-top: 48px; padding-bottom: 64px; }
  .course-card { display: block; border: 1px solid var(--line); border-left: 3px solid var(--gold); background: var(--raised); padding: 26px 28px; color: inherit; text-decoration: none; }
  .course-card:hover, .course-card:focus-visible { border-color: var(--green); }
  .course-card h2 { font-size: 23px; margin: 8px 0 0; }
  .course-card .cohort { font-size: 16px; margin-top: 8px; }
</style>

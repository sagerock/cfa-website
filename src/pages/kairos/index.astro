---
// Kairos Institute home on learn.*. Started 2026-10-16 as the registration index that
// replaced WordPress Gravity Form 137; rebuilt the same day as the full Kairos home
// that will replace the WordPress Kairos pages (centerforanthroposophy.org/programs/
// kairos-institute/ and its subpages) once Caitlin and Lisl approve it (Sage: "This
// site is slowly but surely just moving over to this new platform").
//
// Wording comes from CfA's own WordPress Kairos pages (3869, 41401, 11159, 35259,
// 41421, 40029, 40028), with Lisl Hofer's 10/16 corrections: no Animal-Assisted
// Therapy track and no spring 2026 courses. Do not add program claims that are not
// on those pages or confirmed by Lisl or Karine.
//
// List only courses still open for registration. Remove a card when its
// registration closes. Noindex, the site default.
import Base from '../../layouts/Base.astro';

const courses = [
  {
    href: '/kairos/dyson-mental-health/',
    eyebrow: 'Four online seminars · in progress',
    title: 'The Organic and Psychospiritual Basis of Mental Health',
    who: 'with Dr. James Dyson',
    when: 'Saturdays, September 26 – November 7, 2026 · 3:00 – 5:00 PM Eastern',
    price: '$350 for the series',
  },
  {
    href: '/kairos/emergency-pedagogy-module-7/',
    eyebrow: 'Emergency Pedagogy · online module',
    title: 'Module 7: Disaster, Healing Communities, and Animals',
    who: 'with Bernd Ruf',
    when: 'Friday and Saturday, January 15 – 16, 2027',
    price: '$350 · optional EPWB certificate $45',
  },
  {
    href: '/kairos/gloeckler-bridge-lectures/',
    eyebrow: 'The Bridge Lectures · three Sunday seminars',
    title: 'Enthusiasm as Warmth to Counter the Cold of our Times',
    who: 'with Dr. Michaela Glöckler',
    when: 'January 24, February 14 and February 21, 2027',
    price: '$350 for all six sessions',
  },
];

const wpKairos = 'https://centerforanthroposophy.org/programs/kairos-institute';
---

<Base
  title="Kairos Institute: Healing in a World of Need | Center for Anthroposophy"
  portalLabel={null}
  minimal
>
  <header class="kairos-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow series-link">Kairos Institute at the Center for Anthroposophy</p>
        <h1>Healing in a World of Need</h1>
        <p class="intro-copy">Kairos Institute offers courses and programs for the general public and more
          immersive, career-oriented programs in artistic therapy and trauma pedagogy training. It is a soul
          school where all are welcomed into a living process dedicated to healing.</p>
        <div class="hero-actions">
          <a class="btn-primary" href="#courses">See open courses</a>
          <a class="btn-secondary" href="#programs">Training programs</a>
        </div>
      </div>
      <figure class="hero-art">
        <img src="/images/kairos/kairos-healing-painting.jpg" width="617" height="466"
          alt="A soft watercolor of a face among roses and a small bird" />
      </figure>
    </div>
  </header>

  <section class="wrap band-section" id="courses" aria-labelledby="courses-title">
    <p class="eyebrow">Open to the public</p>
    <h2 id="courses-title">Courses open for registration</h2>
    <p class="section-lede">Each course has its own registration page.</p>
    <div class="course-grid">
      {courses.map((course) => (
        <a class="course-card" href={course.href}>
          <p class="eyebrow">{course.eyebrow}</p>
          <h3>{course.title}</h3>
          <p class="cohort">{course.who}</p>
          <p class="course-details">{course.when}</p>
          <p class="course-format">{course.price}</p>
          <span class="course-link">Learn more and register <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="programs-band" id="programs" aria-labelledby="programs-title">
    <div class="wrap">
      <p class="eyebrow">Immersive programs</p>
      <h2 id="programs-title">Professional training</h2>
      <p class="section-lede">The Kairos Institute at the Center for Anthroposophy, founded by Karine Munk Finser,
        provides professional training in healing artistic therapies and Emergency Pedagogy, addressing global
        suffering and trauma.</p>

      <article class="program">
        <img src="/images/kairos/kairos-art-therapy-studio.jpg" width="1200" height="764" loading="lazy"
          alt="Students working with pastels at long tables in a Kairos studio" />
        <div>
          <h3>Training in Art Therapies</h3>
          <p>Kairos is a cooperative member of iARTe. Students work toward a Diploma from the Medical Section at
            the Goetheanum in Switzerland. The artistic therapies offered include painting, clay, and drawing,
            which are designed to promote healing and self-discovery.</p>
          <p>This part-time program takes place online and over two week-long residencies each year, complemented
            by artistic studios and online classes. The training lasts approximately four years, depending on
            experience.</p>
          <p class="who"><strong>Who it's for:</strong> anyone wishing to become a therapeutic artist, care group
            leaders, educators, special educators, school leaders, Camphill workers, and others in the healing
            professions.</p>
          <p class="who"><strong>2027 residencies:</strong> spring in Keene, NH (April 23 – 30) and summer in
            Wilton, NH (July).</p>
          <p>To ask about joining the program, write to Karine Munk Finser at
            <a href="mailto:karine@centerforanthroposophy.org">karine@centerforanthroposophy.org</a>.</p>
        </div>
      </article>

      <article class="program">
        <img src="/images/kairos/kairos-emergency-pedagogy-asheville.jpg" width="1024" height="768" loading="lazy"
          alt="A large circle of adults and children with arms raised outdoors during a crisis intervention" />
        <div>
          <h3>Emergency Pedagogy and Trauma Pedagogy</h3>
          <p>Emergency pedagogy is a field that provides immediate pedagogical support to children and youth in the
            acute phase after experiencing traumatic events such as war, natural disasters, or other catastrophes.
            These courses can be taken as a training or as selective courses to support professional or personal
            development.</p>
          <p>Kairos is an English-language site for Bernd Ruf's trauma and crisis intervention modules. These
            modules deepen students' understanding of trauma-preventative pedagogical and artistic healing
            approaches. Students work toward a Certificate in International Crisis Intervention, and some modules
            are included in the Kairos training.</p>
          <p class="who"><strong>How it works:</strong> the curriculum has a modular structure of twelve modules.
            The modules can be taken in sequence, but this is not compulsory.</p>
          <p><a class="text-link" href="/kairos/emergency-pedagogy-module-7/">Next module: Module 7, January 15 – 16,
            2027, online <span aria-hidden="true">→</span></a></p>
        </div>
      </article>
    </div>
  </section>

  <section class="wrap band-section about-grid" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">About Kairos</p>
      <h2 id="about-title">A community that journeys together</h2>
      <p>Students in Kairos form a supportive community who journey together over several years. During this time,
        they develop skills to strengthen resilience and self-healing capacities for themselves and others.</p>
      <p>A renowned international faculty contributes to making Kairos a vibrant school of learning. This work is
        based on careful training in observation and living into another person's needs. Empathy and compassion
        form the foundation of our creativity; and together with the practice and development of artistic
        capacities, human beings can become medicine for one another.</p>
    </div>
    <img class="about-art" src="/images/kairos/kairos-painting-figures.jpg" width="300" height="300" loading="lazy"
      alt="A painting of luminous figures in blue and gold" />
  </section>

  <section class="faculty-band" aria-labelledby="faculty-title">
    <div class="wrap">
      <p class="eyebrow">Faculty</p>
      <h2 id="faculty-title">Who teaches</h2>
      <div class="faculty-grid">
        <div class="person">
          <img src="/images/f7c251138c-karine-munk-finser-300x300.jpg" width="300" height="300" loading="lazy"
            alt="Karine Munk Finser" />
          <div>
            <h3>Karine Munk Finser</h3>
            <p class="role">Director, Kairos Institute</p>
            <p>Karine founded the Kairos Institute. She is an art therapist with a diploma from the Medical
              Section, Goetheanum, and an active painter.</p>
          </div>
        </div>
        <div class="person">
          <img src="/images/51b35b4e70-portrait-of-bernd-ruf-300x300.jpg" width="300" height="300" loading="lazy"
            alt="Bernd Ruf" />
          <div>
            <h3>Bernd Ruf</h3>
            <p class="role">Founder of Parzival School and Emergency Pedagogy</p>
            <p>Author of <em>Educating Traumatized Children</em>, Bernd Ruf is the founder of the worldwide
              Emergency Pedagogy crisis intervention center, based in Karlsruhe, Germany. Skilled teams are sent
              out to help traumatized children in places of war or ecological disaster.</p>
          </div>
        </div>
      </div>
      <p class="guest-line">Guest faculty this year include
        <a href="/kairos/dyson-mental-health/">James Dyson, M.D.</a> and
        <a href="/kairos/gloeckler-bridge-lectures/">Michaela Glöckler, M.D.</a></p>
    </div>
  </section>

  <section class="wrap band-section two-col" aria-label="Financial aid and enrolled students">
    <div>
      <p class="eyebrow">Financial aid</p>
      <h2>Help with tuition</h2>
      <p>Limited financial aid is available upon request.
        <a href="/kairos/financial-aid/">Apply for financial aid</a>.</p>
      <p>Only one discount is honored at a time, usually the greater one. We are not able to fund multiple
        discounts stacked one on top of the other.</p>
      <p>Canadian residents: a 20% currency adjustment is applied automatically at checkout when your billing
        address is in Canada.</p>
      <p>Donations are gratefully accepted to support the Kairos students' scholarship fund.
        <a href="https://centerforanthroposophy.org/programs/kairos-institute-donate/">Donate to Kairos</a>.</p>
    </div>
    <div>
      <p class="eyebrow">For enrolled students</p>
      <h2>Tuition 2026–27</h2>
      <p>For enrolled Kairos Art Therapy students, tuition for the year is $4,300. It includes all online
        classes, online studios, and online seminars and office hours. Ten-month payment plans of $430 a month,
        or as set up individually with Milan, are available.</p>
      <p>Supervision of fieldwork is $300 per term.</p>
      <p class="small">Registered Kairos participants may withdraw from the program before it begins by emailing
        our administrator at <a href="mailto:milan@centerforanthroposophy.org">milan@centerforanthroposophy.org</a>.
        When the request is received at least 30 days before the program begins, tuition and materials fees (less a
        $75 cancellation fee) are refunded. No refunds are possible within 30 days of the start date.
        <a href={`${wpKairos}/kairos-institute-tuition/`}>Full tuition details and policies</a>.</p>
    </div>
  </section>

  <section class="contact-band" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 id="contact-title">Questions?</h2>
      <p>For questions and more information on our programs, write to
        Karine Munk Finser, Director (<a href="mailto:karine@centerforanthroposophy.org">karine@centerforanthroposophy.org</a>),
        or Lisl Hofer (<a href="mailto:lisl@centerforanthroposophy.org">lisl@centerforanthroposophy.org</a>), or use the
        <a href="/kairos/inquiry/">question form</a>. Phone: <a href="tel:+16036542566">603.654.2566</a>.</p>
    </div>
  </section>
</Base>

<style>
  .kairos-hero {
    border-bottom: 1px solid var(--line);
    background: linear-gradient(120deg, rgba(176, 136, 16, 0.12), transparent 62%);
    padding: 56px 0 48px;
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 48px; align-items: center; }
  .kairos-hero h1 { font-size: clamp(36px, 4.6vw, 58px); letter-spacing: -0.035em; margin-top: 6px; }
  .series-link { color: var(--green-ink); }
  .intro-copy { color: var(--soft); font-size: 20px; max-width: 52ch; margin-top: 24px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .btn-primary, .btn-secondary { font: 600 15px var(--sans); padding: 12px 22px; border-radius: 4px; text-decoration: none; }
  .btn-primary { background: var(--green); color: var(--paper); border: 1px solid var(--green); }
  .btn-secondary { color: var(--green-ink); border: 1px solid var(--line); background: var(--raised); }
  .btn-primary:hover, .btn-secondary:hover { opacity: 0.9; }
  .hero-art { margin: 0; }
  .hero-art img { width: 100%; height: auto; border-radius: 6px; display: block; box-shadow: 0 10px 30px rgba(0,0,0,0.08); }

  .band-section { padding-top: 56px; padding-bottom: 56px; }
  .band-section h2, .programs-band h2, .faculty-band h2 { font-size: clamp(28px, 3.2vw, 40px); letter-spacing: -0.02em; margin-top: 6px; }
  .section-lede { color: var(--soft); font-size: 18px; max-width: 64ch; margin-top: 14px; }

  .course-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin-top: 30px; }
  .course-card { display: block; border: 1px solid var(--line); border-left: 3px solid var(--gold); background: var(--raised); padding: 26px 28px; color: inherit; text-decoration: none; }
  .course-card:hover, .course-card:focus-visible { border-color: var(--green); }
  .course-card h3 { font-size: 23px; margin: 8px 0 0; }
  .cohort { color: var(--gold); font-family: var(--sans); font-size: 16px; letter-spacing: 0.035em; margin-top: 8px; }
  .course-details { font: 600 15px/1.7 var(--sans); margin-top: 18px; }
  .course-format { color: var(--soft); font: 14px/1.7 var(--sans); margin-top: 6px; }
  .course-link { display: inline-flex; gap: 12px; margin-top: 20px; color: var(--green-ink); font: 600 15px var(--sans); }

  .programs-band, .faculty-band { background: var(--raised); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 56px 0; }
  .program { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 40px; align-items: start; margin-top: 44px; }
  .program img { width: 100%; height: auto; border-radius: 6px; display: block; }
  .program h3 { font-size: 26px; margin-bottom: 12px; }
  .program p { margin-top: 12px; max-width: 64ch; }
  .program .who { font: 15px/1.7 var(--sans); color: var(--ink); }
  .text-link { color: var(--green-ink); font: 600 15px var(--sans); }

  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 48px; align-items: center; }
  .about-grid p { margin-top: 14px; max-width: 66ch; }
  .about-art { width: 100%; height: auto; border-radius: 6px; }

  .faculty-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; margin-top: 30px; }
  .person { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 22px; align-items: start; }
  .person img { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; }
  .person h3 { font-size: 21px; }
  .person .role { color: var(--gold); font: 14px var(--sans); letter-spacing: 0.03em; margin-top: 4px; }
  .person p { margin-top: 10px; }
  .guest-line { margin-top: 30px; font: 15px/1.7 var(--sans); }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .two-col p { margin-top: 12px; }
  .small { font: 14px/1.7 var(--sans); color: var(--soft); }

  .contact-band { border-top: 1px solid var(--line); padding: 48px 0 64px; }
  .contact-band p { margin-top: 12px; max-width: 70ch; }

  @media (max-width: 820px) {
    .hero-grid, .program, .about-grid, .two-col { grid-template-columns: 1fr; gap: 26px; }
    .about-art { max-width: 260px; }
  }
  @media (max-width: 560px) {
    .kairos-hero { padding: 38px 0 34px; }
    .person { grid-template-columns: 80px minmax(0, 1fr); }
    .person img { width: 80px; height: 80px; }
  }
</style>

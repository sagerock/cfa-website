---
import Learn from '../../layouts/Learn.astro';
import MuxVideo from '../../components/MuxVideo.astro';
import { ignitePilot } from '../../data/ignitePilot.js';

const nextSession = ignitePilot.sessions.find((session) => session.id === ignitePilot.nextSessionId);
---

<Learn title={`${ignitePilot.title} — Learning Portal`}>
  <div class="course-hero">
    <div class="wrap">
      <a class="back" href="/learn">← My courses</a>
      <div class="course-hero-grid">
        <div>
          <p class="eyebrow">{ignitePilot.cohort}</p>
          <h1>{ignitePilot.title}</h1>
          <p class="course-subtitle">{ignitePilot.subtitle}</p>
        </div>
        <div class="facilitator">
          <span>Program facilitator</span>
          <strong>{ignitePilot.facilitator}</strong>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap course-grid">
    <div class="course-main">
      {nextSession && (
        <section class="next-session">
          <div class="next-kicker">
            <span class="live-dot"></span>
            Next live seminar
          </div>
          <p class="session-presenter">{nextSession.presenter}</p>
          <h2>{nextSession.title}</h2>
          <div class="session-time">
            <span>{nextSession.date}</span>
            <span>{nextSession.time}</span>
          </div>
          <button class="join-button" type="button" disabled>Join link appears after sign-in</button>
          <p class="privacy-note">The live Zoom link will be returned by Supabase only to enrolled participants.</p>
        </section>
      )}

      <section class="curriculum" aria-labelledby="curriculum-title">
        <div class="section-title">
          <p class="eyebrow">Course path</p>
          <h2 id="curriculum-title">Seminars and recordings</h2>
        </div>
        <ol class="session-list">
          {ignitePilot.sessions.map((session, index) => (
            <li class:list={{ active: session.id === ignitePilot.nextSessionId }}>
              <span class="session-number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <span class="session-state">{session.status === 'upcoming' ? 'Next session' : 'Scheduled'}</span>
                <h3>{session.title}</h3>
                <p>{session.presenter} · {session.date}</p>
              </div>
              <span class="session-arrow" aria-hidden="true">{session.status === 'upcoming' ? '→' : '·'}</span>
            </li>
          ))}
        </ol>
      </section>

      <MuxVideo
        playbackId={ignitePilot.pilotMuxPlaybackId}
        eyebrow="Technical pilot"
        title="Mux playback test"
        emptyMessage="The Mux sample video is still processing."
      />
    </div>

    <aside class="course-side">
      <section class="side-card welcome-card">
        <p class="eyebrow">Begin here</p>
        <h2>Welcome to Ignite</h2>
        <p>Your welcome letter and orientation will live here, available whenever you need them.</p>
        <button type="button" disabled>Open welcome letter</button>
      </section>

      <section class="side-card">
        <div class="side-title">
          <h2>Resources</h2>
          <span>{ignitePilot.resources.length}</span>
        </div>
        <ul class="resource-list">
          {ignitePilot.resources.map((resource) => (
            <li>
              <span class="resource-icon" aria-hidden="true">{resource.status === 'available' ? '↗' : '+'}</span>
              <div>
                <strong>{resource.title}</strong>
                <span>{resource.detail}</span>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="help-card">
        <span>Need help?</span>
        <p>Course questions go to the program team. Account support goes to the CfA office.</p>
        <a href="mailto:office@centerforanthroposophy.org">office@centerforanthroposophy.org</a>
      </section>
    </aside>
  </div>
</Learn>

<style>
  .course-hero { padding: 28px 0 42px; border-bottom: 1px solid var(--line); background: var(--raised); }
  .back { display: inline-block; margin-bottom: 26px; color: var(--soft); font-family: var(--sans); font-size: 12px; text-decoration: none; }
  .back:hover { color: var(--green-ink); }
  .course-hero-grid { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; }
  .course-hero h1 { margin: 6px 0 8px; font-size: clamp(42px, 8vw, 72px); letter-spacing: -.025em; }
  .course-subtitle { color: var(--soft); font-size: clamp(17px, 2.4vw, 21px); font-style: italic; }
  .facilitator { display: flex; flex-direction: column; min-width: 220px; padding-left: 18px; border-left: 2px solid var(--gold); font-family: var(--sans); }
  .facilitator span { color: var(--soft); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .facilitator strong { margin-top: 3px; font-size: 14px; }
  .course-grid { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 34px; padding-top: 38px; }
  .course-main { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .next-session { position: relative; overflow: hidden; padding: 28px 30px; border-radius: 7px; color: #edf2ec; background: #203128; box-shadow: 0 18px 45px -34px #000; }
  .next-session::after { content: ''; position: absolute; width: 250px; height: 250px; right: -110px; top: -140px; border: 1px solid rgba(127, 192, 163, .32); border-radius: 50%; box-shadow: 0 0 0 28px rgba(127, 192, 163, .04), 0 0 0 56px rgba(127, 192, 163, .025); }
  .next-kicker { display: flex; align-items: center; gap: 8px; color: #a9cbb8; font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: #e4c05c; box-shadow: 0 0 0 4px rgba(228, 192, 92, .13); }
  .session-presenter { margin-top: 25px; color: #a9cbb8; font-family: var(--sans); font-size: 13px; }
  .next-session h2 { max-width: 25ch; margin: 7px 0 19px; font-size: clamp(24px, 4vw, 34px); }
  .session-time { display: flex; gap: 7px 22px; flex-wrap: wrap; color: #cad6ce; font-family: var(--sans); font-size: 13px; }
  .join-button, .welcome-card button { margin-top: 25px; border: 1px solid rgba(255, 255, 255, .3); border-radius: 3px; padding: 10px 15px; color: #b5c2ba; background: rgba(255,255,255,.05); font-family: var(--sans); font-size: 12px; }
  .privacy-note { margin-top: 9px; color: #8da095; font-family: var(--sans); font-size: 11px; }
  .curriculum { padding: 7px 0; }
  .section-title { margin-bottom: 17px; }
  .section-title h2 { margin-top: 5px; font-size: 27px; }
  .session-list { list-style: none; border-top: 1px solid var(--line); }
  .session-list li { display: grid; grid-template-columns: 45px 1fr 24px; gap: 15px; align-items: center; padding: 19px 4px; border-bottom: 1px solid var(--line); }
  .session-list li.active { background: linear-gradient(90deg, var(--chalk), transparent); }
  .session-number { color: var(--soft); font-family: var(--sans); font-size: 11px; font-variant-numeric: tabular-nums; }
  .session-state { color: var(--green-ink); font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .session-list h3 { margin: 3px 0 4px; font-size: 17px; line-height: 1.3; }
  .session-list p { color: var(--soft); font-family: var(--sans); font-size: 11.5px; }
  .session-arrow { color: var(--green-ink); font-family: var(--sans); font-size: 18px; }
  .course-side { display: flex; flex-direction: column; gap: 17px; }
  .side-card { padding: 20px; border: 1px solid var(--line); border-radius: 7px; background: var(--raised); }
  .side-card h2 { font-size: 19px; }
  .welcome-card { border-top: 3px solid var(--gold); }
  .welcome-card h2 { margin: 6px 0 9px; font-size: 22px; }
  .welcome-card p { color: var(--soft); font-size: 14px; line-height: 1.5; }
  .welcome-card button { width: 100%; margin-top: 17px; border-color: var(--line); color: var(--soft); background: var(--paper); }
  .side-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .side-title span { display: grid; place-items: center; width: 23px; height: 23px; border-radius: 50%; color: var(--green-ink); background: var(--chalk); font-family: var(--sans); font-size: 11px; }
  .resource-list { list-style: none; }
  .resource-list li { display: flex; gap: 10px; padding: 12px 0; border-top: 1px dotted var(--line); }
  .resource-icon { color: var(--green-ink); font-family: var(--sans); }
  .resource-list div { display: flex; flex-direction: column; }
  .resource-list strong { font-family: var(--sans); font-size: 12px; line-height: 1.4; }
  .resource-list div span { color: var(--soft); font-family: var(--sans); font-size: 10.5px; }
  .help-card { padding: 4px 8px; color: var(--soft); font-family: var(--sans); font-size: 11.5px; }
  .help-card > span { color: var(--ink); font-size: 12px; font-weight: 600; }
  .help-card p { margin: 5px 0; line-height: 1.5; }
  @media (max-width: 820px) {
    .course-hero-grid { align-items: flex-start; flex-direction: column; }
    .course-grid { grid-template-columns: 1fr; }
    .course-side { display: grid; grid-template-columns: 1fr 1fr; }
    .help-card { grid-column: 1 / -1; }
  }
  @media (max-width: 580px) {
    .course-side { display: flex; }
    .next-session { padding: 23px 21px; }
    .session-list li { grid-template-columns: 32px 1fr 16px; gap: 9px; }
  }
</style>

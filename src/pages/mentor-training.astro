---
// Landing page and registration for the Mentor Training Program, 2027 cohort
// (Karen Atkinson). Copy comes from the program's existing public page
// (/programs/mentor-training) and the 2027 schedule; dates, tuition and the
// payment plan were confirmed by Sage on 2026-10-15.
//
// The checkout lives in src/components/MentorTrainingCheckout.astro and is kept
// out of this file on purpose, the same split as /biografia and the Bridge
// Lectures: copy, layout and imagery can change here without touching the form
// that takes payment.
//
// Left noindex (the site default) while this is a review preview.
//
// Layout follows the Explorations enroll page CfA pointed to (hero, what it
// is, schedule, faculty, pricing, FAQ, enroll), in this site's own tokens.
import Base from '../layouts/Base.astro';
import MentorTrainingCheckout from '../components/MentorTrainingCheckout.astro';

// Karen's welcome video. Paste the YouTube video id here (the part after
// "v=" or "youtu.be/") once it is published; until then nothing is shown.
const WELCOME_VIDEO_YOUTUBE_ID = '';

// The free webinar / open house registration link. Leave empty until it
// exists; the page says a link is coming.
const WEBINAR_REGISTRATION_URL = 'https://mentor-open-house.centerforanthroposophy.org/';

// Karen's own lighthouse photograph (Elsy 2026-10-20: replaces the earlier AI-generated image).
const HERO_IMAGE = '/images/mentor-training/lighthouse-hero.webp';

const AWSNA_REPORT_URL = '/files/mentor-training/lessons-from-the-mentoring-initiative.pdf';

const schedule = [
  {
    date: 'Saturday, January 23, 2027',
    where: 'Online',
    title: 'The Architecture of Becoming: Where Your Journey in Mentoring, Coaching, Evaluation, and Pedagogical Leadership Begins',
    with: 'Karen Atkinson',
    art: 'Artistic Engagement with Malina Stoychev: Exploring Form Drawing for Focus and Balance',
  },
  {
    date: 'Saturday, February 20, 2027',
    where: 'Online',
    title: 'In Rhythm, In Relationship: Breathing Together in Support of Professional Development Pathways',
    with: 'Sven Saar',
    art: 'Artistic Engagement with Malina Stoychev: Exploring the Color Wheel with Pastels',
  },
  {
    date: 'Saturday, March 13, 2027',
    where: 'Online',
    title: 'Kindling Warmth: The Soul Force Behind Inspired Mentoring, Coaching, and Best Practices for the Teaching Journey',
    with: 'Sven Saar',
    art: 'Artistic Engagement with Malina Stoychev: Exploring the Soul Qualities of Color through Painting',
  },
  {
    date: 'Saturday, April 17, 2027',
    where: 'Online',
    title: 'Charting Your Path: Advisory Conversations and Collective Wisdom',
    with: 'Karen Atkinson',
    art: 'Artistic Movement with Malina Stoychev: Balance and Visual Exercises',
  },
  {
    date: 'Saturday, May 8, 2027',
    where: 'Online',
    title: 'Inner Alchemy and the Art of Nourishment: Metabolizing Experience and Transforming What We Absorb into Living Wisdom',
    with: 'Sarah Nelson',
    art: 'Artistic Engagement with Malina Stoychev: Exploring Biography Work through Drawing and Painting',
  },
  {
    date: 'Sunday, June 27 – Friday, July 2, 2027',
    where: 'In-person residency · Wilton, NH',
    title: 'Circulating, Maintaining, Growing: A Week of Deepening Practice in Mentoring, Coaching, Evaluation, and Pedagogical Leadership',
    with: 'Karen Atkinson',
    art: 'Eurythmy with Alexandra Spadea · Artistic Engagement with Narsingh Khalsa',
    residency: true,
  },
  {
    date: 'Saturday, September 25, 2027',
    where: 'Online',
    title: 'The Fruits of Our Work: Producing with Purpose and Presence',
    with: 'Carol Bärtges',
    art: 'Artistic Engagement with Malina Stoychev: Exploring Form Drawing and Free Hand Geometry',
  },
  {
    date: 'Saturday, October 23, 2027',
    where: 'Online',
    title: 'Threads of Destiny: The Karmic Impact of Serving in Mentoring, Coaching, and Pedagogical Leadership',
    with: 'Lori Kran',
    art: 'Artistic Engagement with Malina Stoychev: The Magic of Social Color Exercises',
  },
  {
    date: 'Saturday, November 13, 2027',
    where: 'Online',
    title: 'Harvesting Wisdom: Celebrating the Journey. Bringing Cultivated Wisdom to Emerging Teachers and Pedagogical Leaders Across the Waldorf Movement',
    with: 'Karen Atkinson',
    art: null,
  },
];

// Short lines drawn from each person's bio in src/data/faculty.json.
const faculty = [
  { name: 'Karen Atkinson, M.Ed.', role: 'Program director', photo: '/images/mentor-training/karen-atkinson-2026.webp',
    line: 'Over 35 years as an early childhood educator, class teacher, pedagogical leader and adult educator.' },
  { name: 'Sven Saar', role: 'February and March sessions', photo: '/images/7bea8dc34e-svensaar.png',
    line: 'Class teacher for 30 years; now works full time in teacher education in the UK, Germany, Australia and the US.' },
  { name: 'Sarah Nelson', role: 'May session', photo: '/images/4cf47a8393-nelsonsarah-3-300x300.png',
    line: 'Class teacher at Haleakala Waldorf School in Maui and a regional leader on AWSNA’s Leadership Council.' },
  { name: 'Carol Bärtges', role: 'September session', photo: '/images/61bac200b7-carol-bartges2.webp',
    line: 'High school literature and drama teacher at the Rudolf Steiner School in New York City.' },
  { name: 'Lori Kran, Ph.D.', role: 'October session', photo: '/images/79585d2972-lori-kran-e1751297567922.png',
    line: 'Coordinator of PITEP and former pedagogical director of Shining Mountain Waldorf School.' },
  { name: 'Malina Stoychev', role: 'Artistic engagement', photo: '/images/18f18e64b6-malina-stoychev.png',
    line: 'More than 35 years of Waldorf teaching; class teacher at the Emerson Waldorf School in Chapel Hill, NC.' },
  // Photos and lines from their Renewal bios (Elsy 2026-10-23: pull their pictures from the Renewal/CfA site).
  { name: 'Alexandra Spadea', role: 'Eurythmy, residency', photo: '/images/mentor-training/alexandra-spadea.webp',
    line: 'Eurythmist trained in Dornach and Spring Valley; teaches grades 7–12 at the Rudolf Steiner School in New York City.' },
  { name: 'Narsingh Khalsa', role: 'Artistic engagement, residency', photo: '/images/mentor-training/narsingh-khalsa.webp',
    line: 'Waldorf educator and artist with 18 years of teaching fine arts; class teacher at the Waldorf School of Princeton.' },
];

const initials = (name) => name.split(/[ ,]+/).filter((part) => /^[A-Z]/.test(part)).slice(0, 2).map((part) => part[0]).join('');

const faqs = [
  {
    q: 'Who is the program for?',
    a: 'Experienced Waldorf educators who want to strengthen their skills in mentoring, coaching and professional development; teachers and leaders who want to serve as internal mentors within their faculty and beyond; and seasoned educators and pedagogical chairs ready to bring their experience to a new role of service. All realms of Waldorf education are covered: early childhood, grades, high school and special subjects.',
  },
  {
    q: 'What are the prerequisites?',
    a: 'A Waldorf Teacher Training Certificate from an AWSNA member institute or the equivalent; a minimum of five full-time years of teaching in an independent or public Waldorf school; and a letter of recommendation from your current school leadership. If you are not currently teaching, two letters of recommendation from schools where you have previously taught or mentored. Questions about prerequisites can go to Karen Atkinson.',
    email: true,
  },
  {
    q: 'When do the sessions meet?',
    a: 'Eight Saturdays online, from January 23 to November 13, 2027, plus the in-person residency from Sunday, June 27 to Friday, July 2, 2027, in Wilton, New Hampshire. Session times will be confirmed; Karen will send them to everyone registered.',
  },
  {
    q: 'What does tuition include?',
    a: 'Tuition of $2,650 includes all online sessions, workshops and the week-long in-person residency. Travel and lodging for the residency are not included.',
  },
  {
    q: 'How does the payment plan work?',
    a: 'Choose the ten-payment option at checkout. The first payment of $265 is charged when you register, and the other nine are charged automatically to the same card on the same day of each following month. The total is the same $2,650.',
  },
  {
    q: 'Is there a discount?',
    a: 'Attend the free open house on Wednesday, October 28, 2026 and receive a bonus toward your enrollment. Canadian participants receive 20% off automatically at checkout. Discounts do not combine; the better one applies.',
  },
  {
    q: 'Is financial aid available?',
    a: 'Limited scholarships are available. Please contact the program director, Karen Atkinson, at karen@centerforanthroposophy.org.',
  },
  {
    q: 'What is the cancellation policy?',
    a: 'Requests received at least 30 days before the registration deadline will result in a full refund, less a $100 cancellation fee. No refunds will be granted if cancellation is received within 30 days of the program start date or while in session.',
  },
];

// From the residency reflection forms Elsy shared (2026-10-20). Named quotes come from the
// form's testimonial question, which asks people to add their name for outreach use; the
// unnamed ones were offered there without a name.
const stats = [
  { figure: '100%', text: 'of 2026 residency participants rated the quality of instruction 8 or higher out of 10 (average 9.6)' },
  { figure: '95%', text: 'of 2026 participants gave their main instructor a 9 or 10 out of 10' },
  { figure: '100%', text: 'of 2025 participants rated their overall experience 4 or 5 out of 5' },
  { figure: '100%', text: 'of 2025 participants gave the artistic instruction top marks, 5 out of 5' },
];

const testimonials = [
  { quote: 'The relationships I built through the summer Mentor Training are going to be a meaningful support as I move into the next school year. It is a joy to work with others who have taken on roles in pedagogical leadership at their own schools.', who: 'Liz Hartman, 2026 cohort' },
  { quote: 'The Mentor Program is the medicine needed for our times. We were given both practical tools and insights, as well as inspiration for personal growth and introspection. This program is necessary to continue to help Waldorf education move and grow.', who: '2025 participant' },
  { quote: 'The whole experience of the week was inspirational and uplifting. I really appreciated the generosity of our wise teachers.', who: 'Kathy Lucking, 2026 cohort' },
  { quote: 'The enveloping of eurythmy, singing, speech, and colleagues was like a bath of good will and beauty! What an instructive balm it was!', who: '2026 participant' },
  { quote: 'The inclusivity and caring nature of all of the staff and community filled my heart and will guide me through my upcoming year.', who: 'Jenna Martin, 2025 cohort' },
  { quote: 'Fulfilling, restorative, inspiring!', who: '2025 participant' },
];

// Highlights from "Lessons from the Mentoring Initiative: Implications for AWSNA Institutes"
// (Karen's 2026-10-14 brief: glean highlights from the AWSNA report; Elsy 2026-10-23: add with a download).
const impact = [
  'The program grew out of AWSNA Teacher Life Cycle research, including approximately 100 interviews with Waldorf schools.',
  'The follow-up survey provides encouraging evidence that the training translated into practice.',
  'Participants reported increased confidence and clarity in their mentoring, and most felt well or very well prepared to mentor in their schools.',
  'Graduates mentored new and untrained teachers, experienced Waldorf teachers, educators moving into new roles, special subject teachers, and pedagogical administrators.',
  'Participants used specific tools and frameworks from the training in their mentoring work.',
  'One respondent described the cohort as a “true mentorship family.”',
  'A Level II cohort followed, with participants helping shape the content around the issues they meet in their schools.',
];
---

<Base
  title="Mentor Training Program 2027 | Center for Anthroposophy"
  portalLabel={null}
  minimal
>
  <header class="mt-hero">
    <div class="wrap mt-hero-grid">
      <div class="mt-hero-copy">
        <p class="eyebrow mt-kicker">Mentor Training Program · 2027 cohort</p>
        <h1>Wisdom into Practice</h1>
        <p class="mt-sub">Pedagogical Mentoring, Coaching, and Professional Development Pathways for Waldorf Teachers and Pedagogical Leaders</p>
        <p class="mt-lede">
          Bring the wisdom of your teaching experience into a new role of service. A ten-month,
          low-residency, certificate-earning program inviting experienced teachers and leaders to
          deepen their capacities and learn best practices for guiding mentoring, coaching,
          professional evaluation and pedagogical inspiration.
        </p>
        <ul class="mt-facts">
          <li><strong>January 23 – November 13, 2027</strong></li>
          <li>Eight online Saturday sessions and a one-week in-person residency</li>
          <li>$2,650, or ten monthly payments of $265</li>
        </ul>
        <div class="mt-actions">
          <a class="btn" id="hero-register" href="#registration" data-track="mt2027-hero-register">Registration opens October 28</a>
          <a class="mt-text-link" href="#webinar" data-track="mt2027-hero-webinar">Free webinar, October 28 <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="mt-hero-art">
        <img src={HERO_IMAGE} alt="A white lighthouse with a red lantern rising above tall coastal grasses."
          width="2000" height="1333" fetchpriority="high" />
      </figure>
    </div>
  </header>

  {WELCOME_VIDEO_YOUTUBE_ID && (
    <section class="wrap mt-video" aria-labelledby="video-title">
      <p class="eyebrow">A welcome from the director</p>
      <h2 id="video-title">Hear from Karen Atkinson</h2>
      <div class="mt-video-frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${WELCOME_VIDEO_YOUTUBE_ID}?rel=0`}
          title="Welcome to the Mentor Training Program from Karen Atkinson"
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  )}

  <section class="mt-strip" aria-label="The program at a glance">
    <div class="wrap mt-strip-grid">
      <div><strong>10</strong><span>months</span></div>
      <div><strong>8</strong><span>online Saturdays</span></div>
      <div><strong>1</strong><span>residency week in New Hampshire</span></div>
      <div><strong>All realms</strong><span>early childhood, grades, high school, special subjects, and pedagogical leaders</span></div>
    </div>
  </section>

  <section class="wrap mt-section mt-two" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">The program</p>
      <h2 id="about-title">Become a mentor, coach, and professional appraiser for Waldorf teachers</h2>
      <p class="mt-about-sub">Bringing the wisdom of pedagogical leadership and inspiration to your
        school and to a wider network of schools.</p>
    </div>
    <div class="mt-prose">
      <p>This low-residency, certificate-earning training is designed for experienced teachers who
        wish to deepen their skills in pedagogical mentoring, coaching, and professional evaluation,
        as well as learning best practices for leading and supporting the ongoing journey of personal
        and professional growth through pedagogical inspiration. Over ten
        months, participants engage in a comprehensive training that strengthens personal
        capacities and prepares them to better support practicing teachers in Waldorf schools today.</p>
      <p>The program combines virtual and in-person learning. Participants meet once a month on
        Saturdays with program faculty, and for one week in person in the summer. Through a focus on
        best practices, fresh perspectives, and innovative approaches, it prepares graduates to offer
        mentorship, professional development guidance, evaluative support, and pedagogical
        inspiration to schools seeking to support their new and developing Waldorf educators.</p>
    </div>
  </section>

  <section class="wrap mt-section" aria-labelledby="benefits-title">
    <p class="eyebrow">What it brings</p>
    <h2 id="benefits-title">For you, and for your school</h2>
    <div class="mt-cards">
      <article class="mt-card">
        <h3>For individuals</h3>
        <ul>
          <li>Cultivate your capacity and confidence to serve as a mentor, coach, evaluator, and pedagogical leader.</li>
          <li>Learn practical strategies for observation, feedback, communication, and conflict navigation.</li>
          <li>Deepen inner development and personal renewal.</li>
          <li>Experience artistic, reflective, and practical elements of transformation.</li>
          <li>Join an international community of committed Waldorf coaches and mentors.</li>
        </ul>
      </article>
      <article class="mt-card">
        <h3>For schools</h3>
        <ul>
          <li>Meet teachers’ needs through pedagogical mentoring, on-the-ground coaching, and pedagogical inspiration: an economical and sustainable way to build in-house mentoring and pedagogical leadership capacity.</li>
          <li>Sponsor one or more seasoned teachers and bring best practices and professional mentoring skills back to your community.</li>
          <li>Strengthen faculty retention and morale with ongoing professional support.</li>
          <li>Keep faculty mentoring grounded in anthroposophy and the shared values of Waldorf education.</li>
          <li>Support new and developing teachers, increasing classroom success and reducing burnout.</li>
        </ul>
      </article>
      <article class="mt-card">
        <h3>Independent project</h3>
        <ul>
          <li>Actively engage in mentoring throughout the course.</li>
          <li>Keep a reflective journal of mentoring sessions, observations, dialogues, and lessons learned.</li>
          <li>Develop a final project tailored to your own circumstances and professional context, showing how your learning lives in practice.</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="mt-photos" aria-label="Photographs from the summer residencies">
    <div class="wrap mt-photo-grid">
      <figure class="mt-photo-a">
        <img src="/images/mentor-training/residency-vibrant-class.webp"
          alt="Karen Atkinson teaching at the chalkboard to a full classroom of Mentor Training participants."
          width="2000" height="1335" loading="lazy" />
      </figure>
      <figure class="mt-photo-b">
        <img src="/images/mentor-training/residency-giraffe-pastel.webp"
          alt="A participant's pastel drawing of a giraffe beneath a glowing moon."
          width="1000" height="1333" loading="lazy" />
      </figure>
      <figure class="mt-photo-c">
        <img src="/images/mentor-training/residency-participants-smiling.webp"
          alt="Participants smiling and laughing together during a residency session."
          width="1600" height="1040" loading="lazy" />
      </figure>
      <figure class="mt-photo-d">
        <img src="/images/mentor-training/residency-karen-teaching.webp"
          alt="Karen Atkinson smiling with participants in the classroom."
          width="1600" height="1067" loading="lazy" />
      </figure>
      <figure class="mt-photo-e">
        <img src="/images/mentor-training/residency-2026-cohort.webp"
          alt="Mentor Training participants and faculty gathered under a large old tree at the summer residency."
          width="1600" height="1067" loading="lazy" />
      </figure>
      <figure class="mt-photo-f">
        <img src="/images/mentor-training/residency-2026-movement-circle.webp"
          alt="Participants standing in a wide circle for a movement exercise at the 2026 residency."
          width="1600" height="1067" loading="lazy" />
      </figure>
      <figure class="mt-photo-g">
        <img src="/images/mentor-training/residency-2026-small-group.webp"
          alt="A small group of participants in conversation around a table at the 2026 residency."
          width="1600" height="1067" loading="lazy" />
      </figure>
      <figure class="mt-photo-h">
        <img src="/images/mentor-training/residency-2026-pastel-work.webp"
          alt="Participants working on pastel drawings together at the 2026 residency."
          width="1600" height="1067" loading="lazy" />
      </figure>
    </div>
    <p class="wrap mt-photo-caption">Summer residencies in Wilton, New Hampshire.</p>
  </section>

  <section class="wrap mt-section" id="schedule" aria-labelledby="schedule-title">
    <p class="eyebrow">Schedule · 2027</p>
    <h2 id="schedule-title">Nine gatherings across the year</h2>
    <p class="mt-section-note">Eight online Saturdays and one residency week. Session times will be confirmed.</p>
    <ol class="mt-schedule">
      {schedule.map((item, index) => (
        <li class={item.residency ? 'is-residency' : undefined}>
          <div class="mt-when">
            <span class="mt-no">{String(index + 1).padStart(2, '0')}</span>
            <strong>{item.date}</strong>
            <span class="mt-where">{item.where}</span>
          </div>
          <div class="mt-what">
            <h3>{item.title}</h3>
            <p class="mt-with">with {item.with}</p>
            {item.art && <p class="mt-art">{item.art}</p>}
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-section-note">Travel and lodging for the residency are not included in tuition.</p>
  </section>

  <section class="wrap mt-section mt-director" aria-labelledby="director-title">
    <img class="mt-director-photo" src="/images/mentor-training/karen-atkinson-2026.webp"
      alt="Portrait of Karen Atkinson." width="600" height="600" loading="lazy" />
    <div>
      <p class="eyebrow">Program director</p>
      <h2 id="director-title">Karen Atkinson, M.Ed.</h2>
      <p>Karen is a dedicated educator and leader in Waldorf education, with over 35 years of
        experience as an early childhood educator, grade school class teacher, pedagogical leader,
        and adult educator. A graduate of Antioch University New England, she holds a Master’s in
        Education. She directs the Mentor Training Program and the Renewal Courses and serves as the
        Program Coordinator for the Waldorf Leadership and Community Development Program at the
        Center for Anthroposophy.</p>
      <p class="mt-contact-line">Questions about the program:
        <a href="mailto:karen@centerforanthroposophy.org">karen@centerforanthroposophy.org</a></p>
    </div>
  </section>

  <section class="wrap mt-section" aria-labelledby="faculty-title">
    <p class="eyebrow">Faculty · 2027</p>
    <h2 id="faculty-title">Who you will learn with</h2>
    <ul class="mt-faculty">
      {faculty.map((person) => (
        <li>
          {person.photo
            ? <img src={person.photo} alt="" width="96" height="96" loading="lazy" />
            : <span class="mt-initials" aria-hidden="true">{initials(person.name)}</span>}
          <div>
            <strong>{person.name}</strong>
            <span class="mt-role">{person.role}</span>
            {person.line && <p>{person.line}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-voices" aria-labelledby="voices-title">
    <div class="wrap">
      <p class="eyebrow">What our program participants are saying</p>
      <h2 id="voices-title">In their own words</h2>
      <ul class="mt-stats">
        {stats.map((stat) => (
          <li><strong>{stat.figure}</strong><span>{stat.text}</span></li>
        ))}
      </ul>
      <div class="mt-quotes">
        {testimonials.map((item) => (
          <figure>
            <blockquote>“{item.quote}”</blockquote>
            <figcaption>{item.who}</figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-stats-note">Figures from the anonymous residency reflection forms: 20 responses in 2026
        (rated out of 10) and 27 in 2025 (rated out of 5).</p>
    </div>
  </section>

  <section class="wrap mt-section mt-two" aria-labelledby="impact-title">
    <div>
      <p class="eyebrow">Evidence of impact</p>
      <h2 id="impact-title">The success of the Mentor Training Program</h2>
      <p class="mt-impact-intro">From <em>Lessons from the Mentoring Initiative</em>, a report for AWSNA
        institutes drawing on a follow-up survey of the 2024 and 2025 cohorts.</p>
      <p class="mt-report"><a class="btn" href={AWSNA_REPORT_URL} download data-track="mt2027-awsna-report">Download the report</a></p>
    </div>
    <ul class="mt-impact">
      {impact.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <section class="wrap mt-section" id="webinar" aria-labelledby="webinar-title">
    <div class="mt-webinar">
      <div>
        <p class="eyebrow">Free webinar and open house</p>
        <h2 id="webinar-title">Wednesday, October 28, 2026 · 7:00 PM ET</h2>
        <p>Meet Karen Atkinson, hear how the year unfolds, and bring your questions. Attend the open
          house and receive a bonus toward your enrollment.</p>
      </div>
      <div class="mt-webinar-action">
        {WEBINAR_REGISTRATION_URL
          ? <a class="btn" href={WEBINAR_REGISTRATION_URL} data-track="mt2027-webinar-register">Save your seat</a>
          : <p class="mt-coming">The webinar registration link is coming soon.</p>}
      </div>
    </div>
  </section>

  <section class="wrap mt-section mt-two" aria-labelledby="tuition-title">
    <div>
      <p class="eyebrow">Tuition</p>
      <h2 id="tuition-title">$2,650 for the full program</h2>
      <p class="mt-plan-line">or ten monthly payments of $265</p>
    </div>
    <div class="mt-prose">
      <p>Tuition includes all online sessions, workshops, and the week-long in-person residency.
        Travel and lodging for the residency are not included.</p>
      <p>Attend the open house and receive a bonus toward your enrollment. Limited scholarships are
        available; please contact Karen.</p>
      <p>Registration opens Wednesday, October 28, 2026. Questions go to Karen Atkinson at
        <a href="mailto:karen@centerforanthroposophy.org">karen@centerforanthroposophy.org</a>.</p>
    </div>
  </section>

  <section class="wrap mt-section" aria-labelledby="faq-title">
    <p class="eyebrow">Questions</p>
    <h2 id="faq-title">Frequently asked</h2>
    <div class="mt-faq">
      {faqs.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
          {item.email && <p><a class="mt-email-karen" href="mailto:karen@centerforanthroposophy.org?subject=Mentor%20Training%202027%20prerequisites">Email Karen</a></p>}
        </details>
      ))}
    </div>
  </section>

  <section id="registration" class="mt-register" aria-labelledby="register-title">
